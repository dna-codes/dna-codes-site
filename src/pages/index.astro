---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import DnaHelix from '~/components/DnaHelix.astro';
// import BiggerPicture from '~/components/widgets/BiggerPicture.astro';
// import OverlayTeaser from '~/components/widgets/OverlayTeaser.astro';
import ProductsHighlight from '~/components/widgets/ProductsHighlight.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
// import ProductLayer from '~/components/widgets/ProductLayer.astro';
// import TechnologyLayer from '~/components/widgets/TechnologyLayer.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { WAITLIST_HREF, WAITLIST_TEXT } from '~/navigation';
// import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'DNA Codes — Living Operations for Your Team',
  // title: 'DNA Codes — The Source Code for Your Business',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="AI-native operations"
    actions={[
      { variant: 'primary', text: WAITLIST_TEXT, href: WAITLIST_HREF },
      { text: 'Docs', href: '/docs' },
    ]}
  >
    <DnaHelix
      slot="bg"
      orientation="horizontal"
      helixWidth={120}
      nodeSize={12}
      filled
      style="height:58%;margin-top:5%"
    />

    <Fragment slot="title">
      Your <span class="text-accent">living</span><br />
      operating model
    </Fragment>

    <Fragment slot="subtitle">
      The future of work is humans + agents.<br />
      DNA is the structure and engine behind it.
    </Fragment>
  </Hero>

  <!-- <BiggerPicture /> -->

  <!-- Straight from the headline into the two products, each carrying a real shot of
       itself. The lens demo that used to occupy this space asked a visitor to understand
       "one model, many views" before they knew what either product was; it now runs on
       /operations, where that argument has something to attach to. -->
  <ProductsHighlight />

  <!-- Arrow connector (ops → product) — re-enable with <OverlayTeaser /> below when
       the Overlay launch goes public. -->
  <!-- <div class="flex flex-col items-center -mt-8 -mb-8 relative z-10">
    <div class="w-0.5 h-12 bg-gradient-to-b from-primary/60 to-primary"></div>
    <div
      class="w-10 h-10 rounded-full border-2 border-primary bg-primary/10 shadow-[0_0_24px_rgba(13,148,136,0.5)] flex items-center justify-center"
    >
      <Icon name="tabler:arrow-down" class="w-5 h-5 text-primary" />
    </div>
    <div class="w-0.5 h-12 bg-gradient-to-b from-primary to-primary/60"></div>
  </div>

  <OverlayTeaser /> -->

  <!-- Arrow connector (product → technology) -->
  <!-- <div class="flex flex-col items-center -mt-8 -mb-8 relative z-10">
    <div class="w-0.5 h-12 bg-gradient-to-b from-primary/60 to-primary"></div>
    <div
      class="w-10 h-10 rounded-full border-2 border-primary bg-primary/10 shadow-[0_0_24px_rgba(13,148,136,0.5)] flex items-center justify-center"
    >
      <Icon name="tabler:arrow-down" class="w-5 h-5 text-primary" />
    </div>
    <div class="w-0.5 h-12 bg-gradient-to-b from-primary to-primary/60"></div>
  </div>

  <TechnologyLayer /> -->

  <SocialProof
    note="Building at the intersection of operations and engineering. One shared model across disciplines."
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: WAITLIST_TEXT, href: WAITLIST_HREF },
      { text: 'Explore the products', href: '/operations' },
    ]}
  >
    <Fragment slot="title">
      Bring order<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">&nbsp;to your ops.</span>
    </Fragment>

    <Fragment slot="subtitle"> Encode your processes. Give your team a single source of truth. </Fragment>
  </CallToAction>
</Layout>

