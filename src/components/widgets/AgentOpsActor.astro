---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

// Visual left, prose right — the second beat in the page's alternation.
//
// This section had two panels, three paragraphs and a boxed pull quote, which is four things
// competing to be the one you read. It makes a single claim — *one edge, two kinds of actor* —
// and that claim is a picture: one act, one arrow, forking to a person and a robot with the
// same word on it. Nobody has to be told the words match because they can see that they do.
//
// The audit half used to be a second panel and a quotation. It is now two rows at the foot of
// the same panel, because "which edges exist" and "which edges get written" are the same
// argument and the second is only interesting once you have seen the first.

const actors = [
  { kind: 'person', icon: 'tabler:user', name: 'June Alcott', role: 'Chief Financial Officer' },
  { kind: 'agent', icon: 'tabler:robot', name: 'Accounts Payable Agent', role: 'anthropic/claude-sonnet-5' },
];
---

<WidgetWrapper id="how" containerClass="max-w-5xl mx-auto">
  <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
    <!-- ── The picture ──────────────────────────────────────────────── -->
    <div class="rounded-2xl border border-white/10 bg-slate-900 overflow-hidden shadow-xl">
      <div class="px-3 py-2 border-b border-white/8 flex items-center gap-2">
        <span class="text-[11px] font-semibold text-white border border-primary/60 rounded px-2 py-0.5">Inspect</span>
        <span class="ml-auto text-[10px] font-mono text-slate-500">one act, two performers</span>
      </div>

      <div class="p-5">
        <!-- The act -->
        <div class="mx-auto max-w-[240px] rounded-lg border border-white/15 bg-slate-800 px-3 py-2.5 text-center">
          <p class="text-[9px] uppercase tracking-wider text-slate-500">Action</p>
          <p class="text-sm font-bold text-white leading-tight">Approve Invoice</p>
        </div>

        <!-- The edge, named once -->
        <div class="flex flex-col items-center">
          <div class="w-px h-3.5 bg-primary/50"></div>
          <span
            class="rounded border border-primary/40 bg-primary/10 px-2 py-0.5 text-[10px] font-mono font-bold text-primary"
          >
            OWNED_BY
          </span>
          <div class="w-px h-3.5 bg-primary/50"></div>
        </div>

        <!-- …forking to both kinds of actor. Card centres sit at 25% and 75% of a two-column
             grid, which is where these connectors drop from. -->
        <div class="relative h-4" aria-hidden="true">
          <div class="absolute left-1/4 right-1/4 top-0 h-px bg-primary/50"></div>
          <div class="absolute left-1/4 top-0 h-4 w-px bg-primary/50"></div>
          <div class="absolute right-1/4 top-0 h-4 w-px bg-primary/50"></div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          {
            actors.map((a) => (
              <div
                class:list={[
                  'rounded-lg border px-2.5 py-2.5 text-center',
                  a.kind === 'agent' ? 'border-cyan-400/30 bg-cyan-500/5' : 'border-primary/30 bg-primary/5',
                ]}
              >
                <Icon
                  name={a.icon}
                  class:list={['w-5 h-5 mx-auto mb-1.5', a.kind === 'agent' ? 'text-cyan-300' : 'text-accent']}
                />
                <p class="text-[11px] font-bold text-white leading-tight">{a.name}</p>
                <p class="text-[10px] text-slate-500 leading-tight mt-0.5 truncate">{a.role}</p>
              </div>
            ))
          }
        </div>

        <p class="mt-3.5 text-[11px] text-slate-400 text-center leading-snug">
          The same word on both arrows. Nothing was invented for the one on the right.
        </p>

        <!-- And the two edges that get written when the agent acts for somebody. -->
        <div class="mt-4 pt-3.5 border-t border-white/8">
          <p class="text-[9px] uppercase tracking-wider text-slate-500 mb-1.5">So one act records both</p>
          <div class="space-y-1">
            <div class="flex items-center gap-2 rounded bg-slate-800/50 px-2.5 py-1.5">
              <span class="text-[9px] font-mono text-cyan-300 w-[92px] flex-shrink-0">PERFORMED_BY</span>
              <span class="text-[11px] text-slate-200 truncate">Accounts Payable Agent</span>
            </div>
            <div class="flex items-center gap-2 rounded bg-slate-800/50 px-2.5 py-1.5">
              <span class="text-[9px] font-mono text-accent w-[92px] flex-shrink-0">ON_BEHALF_OF</span>
              <span class="text-[11px] text-slate-200 truncate">June Alcott · CFO</span>
            </div>
          </div>
          <p class="mt-2 text-[10px] text-slate-500 leading-snug">
            Which agent did it, and on whose authority. Different questions — an audit that answers only one answers
            neither well.
          </p>
        </div>
      </div>
    </div>

    <!-- ── The prose ────────────────────────────────────────────────── -->
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">The model</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-5">An agent is an actor. Same edges, same rules.</h2>
      <p class="text-muted leading-relaxed mb-5">
        The edge that gives a person their work admits an agent unchanged, so every report, lens and audit query you
        already have keeps working. None of them had two code paths to begin with.
      </p>
      <p class="text-lg text-white font-semibold leading-snug mb-3">
        Reassigning work between the CFO and an agent is a rewrite of one arrow.
      </p>
      <p class="text-muted leading-relaxed">
        Not a migration, not a new integration, and not a pull request against a prompt — the agent’s instructions live
        in the graph too, so changing how it behaves is a change to your model.
      </p>
    </div>
  </div>
</WidgetWrapper>
