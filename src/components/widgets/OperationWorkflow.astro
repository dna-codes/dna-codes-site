---
import { twMerge } from 'tailwind-merge';

// One business workflow: operations in sequence, with a parallel pair in the middle.
// Vertical on purpose. Four cards in a row do not fit the prose column.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

type Op = {
  n: string;
  actor: string;
  kind: string;
  action: string;
  resource: string;
  condition: string;
};

const groups: Array<{ parallel?: boolean; ops: Op[] }> = [
  {
    ops: [
      {
        n: '1',
        actor: 'Sales lead',
        kind: 'Person',
        action: 'Accept',
        resource: 'Order',
        condition: 'Quote is approved',
      },
    ],
  },
  {
    parallel: true,
    ops: [
      {
        n: '2a',
        actor: 'Warehouse system',
        kind: 'System',
        action: 'Reserve',
        resource: 'Inventory',
        condition: 'Stock is on hand',
      },
      {
        n: '2b',
        actor: 'Payments system',
        kind: 'System',
        action: 'Authorize',
        resource: 'Payment',
        condition: 'Funds are available',
      },
    ],
  },
  {
    ops: [
      {
        n: '3',
        actor: 'Carrier',
        kind: 'System',
        action: 'Ship',
        resource: 'Shipment',
        condition: 'Stock reserved and payment authorized',
      },
    ],
  },
  {
    ops: [
      {
        n: '4',
        actor: 'Billing system',
        kind: 'System',
        action: 'Issue',
        resource: 'Invoice',
        condition: 'The shipment has left',
      },
    ],
  },
];
---

<figure class={twMerge('not-prose my-10', className)}>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/8 p-3 sm:px-4">
      <span class="text-xs font-bold uppercase tracking-widest text-primary">Workflow</span>
      <span class="text-[11px] uppercase tracking-wider text-slate-500">Fulfill an order</span>
    </div>

    <div class="track px-4 py-4 sm:px-5 sm:py-5">
      {
        groups.map((group, i) => (
          <>
            {group.parallel ? (
              <div class="parallel">
                <p class="parallel-label">In parallel</p>
                <div class="parallel-ops">
                  {group.ops.map((op) => (
                    <article class="op-card">
                      <p class="op-kicker">
                        <span class="op-n">{op.n}</span>
                        {op.kind} · {op.actor}
                      </p>
                      <p class="op-line">
                        <span class="op-action">{op.action}</span>
                        <span class="op-arrow" aria-hidden="true">
                          →
                        </span>
                        <span class="op-resource">{op.resource}</span>
                      </p>
                      <p class="op-gate">{op.condition}</p>
                    </article>
                  ))}
                </div>
              </div>
            ) : (
              group.ops.map((op) => (
                <article class="op-card">
                  <p class="op-kicker">
                    <span class="op-n">{op.n}</span>
                    {op.kind} · {op.actor}
                  </p>
                  <p class="op-line">
                    <span class="op-action">{op.action}</span>
                    <span class="op-arrow" aria-hidden="true">
                      →
                    </span>
                    <span class="op-resource">{op.resource}</span>
                  </p>
                  <p class="op-gate">{op.condition}</p>
                </article>
              ))
            )}
            {i < groups.length - 1 && (
              <span class="arrow" aria-hidden="true">
                <span class="arrow-line" />
              </span>
            )}
          </>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    Four operations. Reserve and Authorize run together, and Ship waits on both.
  </figcaption>
</figure>

<style>
  .track {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 28rem;
    margin-inline: auto;
  }

  .op-card {
    min-width: 0;
    flex: 1 1 0;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.75rem;
    background: rgb(30 41 59 / 0.65);
    padding: 0.75rem 0.875rem;
  }
  .op-kicker {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: rgb(148 163 184);
    font-size: 0.75rem;
    line-height: 1.3;
  }
  .op-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 1.125rem;
    height: 1.125rem;
    padding-inline: 0.28rem;
    border-radius: 9999px;
    background: rgb(13 148 136 / 0.25);
    color: rgb(153 246 228);
    font-size: 0.6875rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .op-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .op-action {
    color: rgb(45 212 191);
    font-weight: 600;
  }
  .op-arrow {
    color: rgb(100 116 139);
  }
  .op-resource {
    color: rgb(226 232 240);
  }
  .op-gate {
    margin: 0.4rem 0 0;
    color: rgb(148 163 184);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .parallel {
    flex: 1.2 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px dashed rgb(45 212 191 / 0.4);
    border-radius: 0.875rem;
    background: rgb(13 148 136 / 0.07);
    padding: 0.625rem;
  }
  .parallel-label {
    margin: 0;
    color: rgb(45 212 191);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  .parallel-ops {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }
  .arrow-line {
    width: 2px;
    height: 1.25rem;
    background: linear-gradient(to bottom, rgb(45 212 191 / 0.15), rgb(45 212 191 / 0.85));
    position: relative;
  }
  .arrow-line::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-right: 2px solid rgb(45 212 191);
    border-bottom: 2px solid rgb(45 212 191);
    transform: rotate(45deg);
  }
</style>
