---
import { twMerge } from 'tailwind-merge';

// The abstraction ladder: Intent → Machine, rendered as a DNA-style rail with
// the layers as rungs.
//
// Two modes — toggled by the reader, or locked to one via the `mode` prop:
//   leap   — how it works today: one jump from Intent straight to Code, with
//            everything between it ghosted ("decided, never written down").
//   ladder — how it could work: every layer named and stated.
//
// The rail column and the card column are two columns of one grid. Layer i sits
// on grid row i+1, so the leap chute can be placed as a normal grid item
// spanning rows 1–7 (Intent through Code) instead of being measured and
// positioned at runtime.

type Layer = {
  n: string;
  name: string;
  question: string;
  example: string;
  what: string;
  /** What goes wrong without this layer. Shared by both modes — the problem doesn't change. */
  problem: string;
  /**
   * Leap mode's answer: the layer *is* practiced today, just never as a layer.
   * `gap` is what that practice stops short of — without it the leap view reads
   * like the problem is already solved. Omitted only on Machine / Runtime, the
   * one handoff that has no gap left.
   */
  today: { practice: string; gap?: string };
  /**
   * Ladder mode's answer, in the same shape as `today` so the two modes read as
   * one construct: what you write down, then — in green, mirroring today's amber
   * `gap` — the clause that closes the problem stated above it.
   */
  future: { solution: string; resolves: string };
};

const layers: Layer[] = [
  {
    n: '01',
    name: 'Intent',
    question: 'What do I want to accomplish?',
    example: 'A customer should be able to pay an invoice.',
    what: 'The outcome someone wants, in their own words. No structure, no types, no system boundaries — just a goal.',
    problem:
      'The outcome lives in one person’s head. What counts as done gets settled after the code exists — which is also when it gets argued about.',
    today: {
      practice:
        'User stories, PRDs, tickets, acceptance criteria. Universal — the one layer above code everybody writes.',
      gap: 'But it stops at prose, so the handoff is a person retelling it. Nothing below can read a ticket.',
    },
    future: {
      solution: 'Write the outcome down: what should become possible, and what counts as done.',
      resolves:
        'Now "done" is agreed before the work starts rather than after it — and every term the sentence leans on becomes the next layer’s input.',
    },
  },
  {
    n: '02',
    name: 'Semantics',
    question: 'What does everything mean?',
    example: 'customer, invoice, pay',
    what: 'The vocabulary. Which words carry a specific meaning here, and exactly what each one refers to in this business.',
    problem:
      '<code>customer</code> quietly means the billing contact in one module and the parent account in another. Two correct implementations, one wrong system.',
    today: {
      practice:
        'Domain-Driven Design’s ubiquitous language, data catalogs, dbt docs, schema registries, controlled vocabularies.',
      gap: 'But the glossary and the code are two artifacts kept in step by hand. Renaming a term in the wiki changes nothing downstream.',
    },
    future: {
      solution: 'A glossary of binding terms: what each one refers to here, and what it explicitly is not.',
      resolves:
        'One definition of <code>customer</code>, read by both modules — so they can no longer mean different things without the diff showing it.',
    },
  },
  {
    n: '03',
    name: 'Ontology',
    question: 'What exists, and how is it related?',
    example: 'Customer → owns → Invoice',
    what: 'The entities and the relationships between them — what can exist, what each thing holds, and what it points at.',
    problem:
      'Relationships get rediscovered feature by feature. The schema ends up as an archaeology of past tickets rather than a model of the business.',
    today: {
      practice:
        'OWL, RDF and SPARQL go back decades; knowledge graphs run production search; Palantir built a company on programming against “the ontology.”',
      gap: 'But it reads as a modeling specialty rather than a step in the build, so most teams jump straight to a database schema — which answers how to store this, never what this is.',
    },
    future: {
      solution: 'An entity model, declared up front: what exists, what each thing holds, and how they connect.',
      resolves:
        'The schema becomes a projection of that model instead of the only record of it — so relationships get read rather than rediscovered.',
    },
  },
  {
    n: '04',
    name: 'Operational Model',
    question: 'What can happen, and by whom?',
    example: 'Pay Invoice: Customer → Invoice → status becomes Paid',
    what: 'Operations — the behavior the system allows. Each one names an actor, a target, its preconditions, and the state it leaves behind.',
    problem:
      'Every consumer re-derives the rules for itself. The API permits a payment the UI forbids — and an agent will find that gap before your QA does.',
    today: {
      practice:
        'BPMN, statecharts and XState, workflow engines like Temporal and Camunda, DDD aggregates and commands, policy rules in an authorization service.',
      gap: 'But each models one slice — a process, a state machine, a permission — and none of them holds the operation itself, so the rules stay scattered across all of them.',
    },
    future: {
      solution:
        'One operation definition: actor, target, preconditions, resulting state, and the rules that must hold.',
      resolves:
        'Every consumer reads that definition instead of re-deriving it, so the API and the UI cannot disagree about what a payment is allowed to do.',
    },
  },
  {
    n: '05',
    name: 'Execution Model',
    question: 'How can that operation be exposed and executed?',
    example: 'POST /invoices/:id/pay · MCP tool · workflow step · UI command',
    what: 'The surfaces an operation is reachable through, and the contract each surface honors.',
    problem:
      'The tool description and the endpoint drift apart. An agent calls what it was told exists, not what actually does.',
    today: {
      practice: 'OpenAPI, protobuf, GraphQL SDL, AsyncAPI, JSON Schema — and now MCP tool definitions.',
      gap: 'But each describes a surface, not the operation behind it. Four specs for one behavior, hand-kept, each free to disagree.',
    },
    future: {
      solution: 'Every surface projected from the one operation — REST endpoint, MCP tool, queue consumer, button.',
      resolves:
        'Same preconditions, same effects, same errors by construction — the tool description can no longer promise something the endpoint does not do.',
    },
  },
  {
    n: '06',
    name: 'Code / Program',
    question: 'How do I implement it?',
    example: 'Python, TypeScript, SQL — classes, functions, migrations',
    what: 'The actual instructions: control flow, persistence, validation, error handling.',
    problem:
      'Not a missing layer — the opposite. It is the one thing we have always been forced to write down, which is exactly why it absorbs every decision made above it.',
    today: {
      practice: 'Universal. Nobody ships without it.',
      gap: 'But when it is the only written artifact, reading it cannot tell you which lines are implementation and which are a definition nobody stated.',
    },
    future: {
      solution: 'Implementation and nothing else: control flow, persistence, validation, error handling.',
      resolves:
        'With the definitions living above it, the code stops being the only place they exist — a diff now shows what changed, not what was assumed.',
    },
  },
  {
    n: '07',
    name: 'Technology Stack',
    question: 'What frameworks and runtimes do I use?',
    example: 'Django, React, Next.js, PostgreSQL',
    what: 'The chosen substrate — framework conventions, libraries, data store, deployment target.',
    problem:
      'Rarely inferred, often premature. A stack picked before the operations are known will quietly bend the operations to fit it.',
    today: {
      practice:
        'Framework conventions, dependency manifests, infrastructure-as-code — well documented and loudly argued about.',
      gap: 'But it tends to be the first decision instead of a late one, so the substrate shapes the model rather than serving it.',
    },
    future: {
      solution: 'The substrate picked once the operations are settled: framework, data store, deployment target.',
      resolves:
        'The stack now serves the model rather than bending it — and replacing it later changes how the system runs, not what it means.',
    },
  },
  {
    n: '08',
    name: 'Machine / Runtime',
    question: 'How does the machine execute it?',
    example: 'JS engine, Python interpreter, CPU instructions',
    what: 'Bytecode, JIT, syscalls, silicon. The layer nobody opens.',
    problem:
      'None left. Decades of compiler work made this handoff so dependable it went invisible — and that is the bar every layer above it is still failing.',
    today: {
      practice:
        'Compilers, interpreters, JITs. Fully standardized, fully mechanical, entirely invisible — the one handoff software has actually finished.',
    },
    future: {
      solution:
        'Nothing to build. Instruction selection, register allocation, inlining and vectorization already work this way.',
      resolves:
        'Billions of these decisions get made a day and reviewed by nobody — which is what every layer above is trying to earn.',
    },
  },
];

// Layers 1–6 (Intent → Code) are what the single leap skips. `leaped` marks the
// rail cells hidden in leap mode, where the chute covers them instead.
const LEAP_LAST_LAYER = 5; // zero-based index of Code / Program
const leapRowEnd = LEAP_LAST_LAYER + 2; // exclusive grid-row end for the chute

// The default classes break the figure out of a `prose` column, which is what a
// blog post needs. On a normal page pass `class="lg:mx-0 xl:mx-0"` (or any other
// margin) to cancel the breakout — twMerge drops the conflicting defaults.
//
// Pass `mode` to lock the figure to one view: the toggle is replaced by a static
// label, and only that mode's caption renders. Omit it for the interactive
// two-mode version.
export interface Props {
  class?: string;
  mode?: 'leap' | 'ladder';
}

const { class: className, mode } = Astro.props;

const locked = mode !== undefined;
const initialMode = mode ?? 'leap';

const modeLabels = {
  leap: 'Today: one jump',
  ladder: 'Tomorrow: layer by layer',
} as const;

const figcaptions = {
  leap: 'One jump from a prompt to code — and the four layers it decides along the way without writing any of them down.',
  ladder: 'The eight abstraction layers between intent and execution, each one stated instead of inferred.',
  both: 'The eight abstraction layers between intent and execution — and the single jump we ask a model to make across them today.',
} as const;

// Derived per-row flags. Computed here rather than inline in the template: the
// Astro compiler reads a `<` inside a template expression as the start of a tag.
const rows = layers.map((layer, i) => ({
  layer,
  row: i + 1,
  /** Rail hidden in leap mode — the chute covers Intent through Code. */
  leaped: i <= LEAP_LAST_LAYER,
  /** Ghosted card: the four layers the leap silently decides. */
  ghost: i > 0 && i < 5,
}));
---

<figure
  data-abstraction-stack
  data-mode={initialMode}
  class={twMerge('not-prose my-10 lg:-mx-20 xl:-mx-32', className)}
>
  <div
    class="rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)] overflow-hidden"
  >
    <!-- Header + mode toggle -->
    <div class="flex flex-wrap items-center gap-3 gap-y-2 border-b border-white/8 p-3 sm:px-4">
      <div class="flex flex-shrink-0 items-center gap-2">
        <div
          class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-lg border border-primary/40 bg-primary/25"
        >
          <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path
              stroke-linecap="round"
              d="M4 3c0 6 16 12 16 18M20 3c0 6-16 12-16 18M6.5 6h11M5 10h14M5 14h14M6.5 18h11"></path>
          </svg>
        </div>
        <span class="text-base font-bold uppercase tracking-widest text-primary">Intent → Execution</span>
      </div>
      {
        locked ? (
          <span class="mode-label ml-auto">{modeLabels[initialMode]}</span>
        ) : (
          <div class="ml-auto flex gap-1" role="group" aria-label="View">
            <button data-mode-btn="leap" aria-pressed="true" class="mode-btn">
              {modeLabels.leap}
            </button>
            <button data-mode-btn="ladder" aria-pressed="false" class="mode-btn">
              {modeLabels.ladder}
            </button>
          </div>
        )
      }
    </div>

    <!-- Caption, swapped by mode -->
    <p class="border-b border-white/8 px-4 py-3.5 text-base leading-relaxed text-slate-400 sm:px-5">
      {
        (!locked || mode === 'leap') && (
          <span data-caption="leap">
            One jump from a prompt to code. The four layers in between still get decided — they just rarely get written
            down, so nothing can review them, diff them, or hold a correction. Each one is practiced somewhere in the
            industry. None of them is the default.
          </span>
        )
      }
      {
        (!locked || mode === 'ladder') && (
          <span data-caption="ladder" hidden={!locked}>
            Every layer named and stated. Short hops an agent can take one at a time, each ending in an artifact you can
            read and check.
          </span>
        )
      }
    </p>

    <div class="stack-grid px-3 py-4 sm:px-5 sm:py-6">
      <!-- The leap: one chute from Intent down to Code / Program -->
      <div class="leap" style={`grid-row: 1 / ${leapRowEnd}`} aria-hidden="true">
        <span class="leap-cap"></span>
        <span class="leap-line"></span>
        <span class="leap-label">4 layers, usually inferred</span>
        <span class="leap-line"></span>
        <svg class="leap-arrow" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2 2l6 6 6-6"></path>
        </svg>
      </div>

      {
        rows.map(({ layer, row, leaped, ghost }) => {
          return (
            <>
              <div class="rail" style={`grid-row: ${row}`} data-leaped={leaped ? '' : undefined}>
                <span class="rung" />
              </div>

              <div class="cell" style={`grid-row: ${row}`} data-ghost={ghost ? '' : undefined}>
                <button type="button" class="card" data-card aria-expanded="false">
                  <span class="idx">{layer.n}</span>
                  <span class="head">
                    <span class="lname">
                      {layer.name}
                      <span class="pill-ghost">usually inferred</span>
                    </span>
                    <span class="lq">{layer.question}</span>
                  </span>
                  <span class="ex">
                    <code>{layer.example}</code>
                  </span>
                  <svg class="chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6l4 4 4-4" />
                  </svg>
                </button>

                <div class="detail" hidden>
                  <p class="dwhat">{layer.what}</p>

                  <p class="dnote dnote-problem">
                    <span class="dlabel">Problem</span>
                    <span set:html={layer.problem} />
                  </p>

                  {(!locked || mode === 'leap') && (
                    <p class="dnote dnote-today" data-note="leap">
                      <span class="dlabel">Solution</span>
                      <span set:html={layer.today.practice} />
                      {layer.today.gap && <span class="dgap" set:html={` ${layer.today.gap}`} />}
                    </p>
                  )}

                  {(!locked || mode === 'ladder') && (
                    <p class="dnote dnote-future" data-note="ladder">
                      <span class="dlabel">Solution</span>
                      <span set:html={layer.future.solution} />
                      <span class="dfix" set:html={` ${layer.future.resolves}`} />
                    </p>
                  )}
                </div>
              </div>
            </>
          );
        })
      }
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-white/8 px-4 py-3 sm:px-5">
      <span class="text-base text-slate-500">Tap a layer to open it.</span>
    </div>
  </div>

  <figcaption class="mt-3 px-4 text-center text-base text-slate-500">
    {locked ? figcaptions[initialMode] : figcaptions.both}
  </figcaption>
</figure>

<style>
  .mode-btn {
    border: 1px solid transparent;
    border-radius: 0.5rem;
    color: rgb(100 116 139);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.4375rem 0.875rem;
    transition:
      color 0.15s,
      background-color 0.15s,
      border-color 0.15s;
  }
  .mode-btn:hover {
    background: rgb(255 255 255 / 0.07);
    border-color: rgb(255 255 255 / 0.1);
    color: rgb(203 213 225);
  }
  .mode-btn[aria-pressed='true'] {
    background: rgb(13 148 136 / 0.2);
    border-color: rgb(13 148 136 / 0.4);
    color: rgb(45 212 191);
  }

  /* Locked-mode stand-in for the toggle: same slot, same weight, not a control. */
  .mode-label {
    border: 1px solid rgb(13 148 136 / 0.4);
    border-radius: 0.5rem;
    background: rgb(13 148 136 / 0.2);
    color: rgb(45 212 191);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.4375rem 0.875rem;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 0.5rem;
    row-gap: 0;
  }
  @media (min-width: 640px) {
    .stack-grid {
      grid-template-columns: 3rem minmax(0, 1fr);
      column-gap: 0.875rem;
    }
  }

  /* ── Rail: two strands with a rung at each layer ─────────────────── */
  .rail {
    grid-column: 1;
    position: relative;
    transition: opacity 0.25s ease;
  }
  .rail::before,
  .rail::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, rgb(13 148 136 / 0.45), rgb(13 148 136 / 0.25));
  }
  .rail::before {
    left: 28%;
  }
  .rail::after {
    right: 28%;
  }
  .rung {
    position: absolute;
    top: 50%;
    left: 28%;
    right: 28%;
    height: 2px;
    margin-top: -1px;
    background: linear-gradient(to right, rgb(45 212 191 / 0.9), rgb(13 148 136 / 0.5));
    border-radius: 2px;
  }
  .rung::before,
  .rung::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 9999px;
  }
  .rung::before {
    left: -3.5px;
    background: rgb(45 212 191);
    box-shadow: 0 0 10px rgb(45 212 191 / 0.6);
  }
  .rung::after {
    right: -3.5px;
    background: rgb(13 148 136);
    box-shadow: 0 0 10px rgb(13 148 136 / 0.45);
  }

  [data-mode='leap'] .rail[data-leaped] {
    opacity: 0;
  }

  /* ── The leap chute (leap mode only) ─────────────────────────────── */
  .leap {
    grid-column: 1;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.75rem 0;
    color: rgb(45 212 191);
    transition: opacity 0.25s ease;
  }
  [data-mode='ladder'] .leap {
    opacity: 0;
    pointer-events: none;
  }
  .leap-cap {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: rgb(45 212 191);
    box-shadow: 0 0 14px rgb(45 212 191 / 0.8);
    flex-shrink: 0;
  }
  .leap-line {
    flex: 1 1 auto;
    width: 0;
    border-left: 2px dashed rgb(45 212 191 / 0.55);
    min-height: 1rem;
  }
  .leap-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(45 212 191 / 0.85);
    padding: 0.5rem 0;
    white-space: nowrap;
  }
  .leap-arrow {
    width: 16px;
    height: 10px;
    flex-shrink: 0;
    margin-top: -1px;
  }
  @media (max-width: 480px) {
    .leap-label {
      display: none;
    }
  }

  /* ── Layer cards ─────────────────────────────────────────────────── */
  .cell {
    grid-column: 2;
    padding: 0.25rem 0;
    min-width: 0;
  }
  .card {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      'idx head'
      'ex  ex';
    align-items: center;
    gap: 0.25rem 0.75rem;
    text-align: left;
    cursor: pointer;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.75rem;
    background: rgb(30 41 59 / 0.55);
    padding: 0.875rem 1rem;
    transition:
      border-color 0.15s,
      background-color 0.15s,
      opacity 0.25s ease;
  }
  @media (min-width: 768px) {
    .card {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'idx head ex chev';
      gap: 0.875rem;
    }
  }
  .card:hover {
    border-color: rgb(13 148 136 / 0.45);
    background: rgb(30 41 59 / 0.9);
  }
  .card:focus-visible {
    outline: 2px solid rgb(45 212 191 / 0.7);
    outline-offset: 2px;
  }
  .idx {
    grid-area: idx;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: rgb(100 116 139);
    font-variant-numeric: tabular-nums;
  }
  .head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .lname {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: rgb(241 245 249);
    line-height: 1.25;
  }
  .lq {
    font-size: 1rem;
    color: rgb(148 163 184);
    line-height: 1.45;
  }
  .ex {
    grid-area: ex;
    min-width: 0;
  }
  .ex code {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgb(148 163 184);
    background: rgb(15 23 42 / 0.7);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
  }
  @media (min-width: 768px) {
    .ex {
      max-width: 22rem;
      text-align: right;
    }
  }
  .chev {
    grid-area: chev;
    width: 16px;
    height: 16px;
    color: rgb(100 116 139);
    flex-shrink: 0;
    transition: transform 0.2s ease;
    display: none;
  }
  @media (min-width: 768px) {
    .chev {
      display: block;
    }
  }
  .card[aria-expanded='true'] {
    border-color: rgb(13 148 136 / 0.55);
    background: rgb(30 41 59 / 0.95);
  }
  .card[aria-expanded='true'] .chev {
    transform: rotate(180deg);
    color: rgb(45 212 191);
  }

  /* Shown in leap mode only, on the layers the single jump silently decides. */
  .pill-ghost {
    display: none;
    border-radius: 9999px;
    border: 1px solid rgb(245 158 11 / 0.4);
    background: rgb(245 158 11 / 0.12);
    color: rgb(252 211 77);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.0625rem 0.375rem;
    white-space: nowrap;
  }
  [data-mode='leap'] .cell[data-ghost] .pill-ghost {
    display: inline;
  }
  [data-mode='leap'] .cell[data-ghost] .card {
    opacity: 0.5;
    border-style: dashed;
  }
  [data-mode='leap'] .cell[data-ghost] .card:hover,
  [data-mode='leap'] .cell[data-ghost] .card[aria-expanded='true'] {
    opacity: 1;
  }

  /* ── Expandable detail ───────────────────────────────────────────── */
  .detail {
    padding: 1rem 1rem 0.5rem 1rem;
  }
  @media (min-width: 768px) {
    .detail {
      padding-left: 3rem;
    }
  }
  .dwhat {
    font-size: 1.125rem;
    line-height: 1.7;
    color: rgb(203 213 225);
    margin: 0 0 0.875rem;
  }
  .dnote {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(148 163 184);
    border-left: 2px solid;
    padding-left: 1rem;
    margin: 0 0 0.75rem;
  }
  .dnote-problem {
    border-color: rgb(245 158 11 / 0.5);
  }
  .dnote-today {
    border-color: rgb(148 163 184 / 0.45);
  }
  .dnote-future {
    border-color: rgb(13 148 136 / 0.6);
  }
  /* One Solution note per mode. Both are rendered only in the interactive
     version; a locked figure emits just its own. */
  [data-mode='leap'] [data-note='ladder'],
  [data-mode='ladder'] [data-note='leap'] {
    display: none;
  }
  .dlabel {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.125rem;
  }
  .dnote-problem .dlabel {
    color: rgb(252 211 77);
  }
  .dnote-today .dlabel {
    color: rgb(148 163 184);
  }
  .dnote-future .dlabel {
    color: rgb(45 212 191);
  }
  /* The two halves of a Solution, in mirrored positions: amber for what today's
     practice stops short of, green for how the stated layer closes the Problem. */
  .dgap {
    color: rgb(252 211 77 / 0.85);
  }
  .dfix {
    color: rgb(94 234 212);
  }
  .detail :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9375rem;
    color: rgb(203 213 225);
    background: rgb(15 23 42 / 0.7);
    border-radius: 0.25rem;
    padding: 0.0625rem 0.1875rem;
  }
  .detail :global(strong) {
    color: rgb(241 245 249);
    font-weight: 600;
  }
  .detail :global(em) {
    color: rgb(226 232 240);
    font-style: italic;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail,
    .leap,
    .card,
    .chev {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-abstraction-stack]').forEach((root) => {
    const modeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]'));
    const captions = Array.from(root.querySelectorAll<HTMLElement>('[data-caption]'));

    const setMode = (mode: string) => {
      root.dataset.mode = mode;
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeBtn === mode)));
      captions.forEach((c) => (c.hidden = c.dataset.caption !== mode));
    };

    modeBtns.forEach((btn) => btn.addEventListener('click', () => setMode(btn.dataset.modeBtn!)));

    root.querySelectorAll<HTMLButtonElement>('[data-card]').forEach((card) => {
      const detail = card.nextElementSibling as HTMLElement | null;
      if (!detail) return;
      card.addEventListener('click', () => {
        const open = card.getAttribute('aria-expanded') === 'true';
        card.setAttribute('aria-expanded', String(!open));
        detail.hidden = open;
      });
    });
  });
</script>
