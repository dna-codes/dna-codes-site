---
import { Icon } from 'astro-icon/components';

// The coverage reading, as a panel. Built stub-first like everything else on this site:
// the shape is the console's, the data is staged, and a Demo mode badge sits where the
// live surface names the signed-in person.
//
// It exists as its own component because it is the product's opening line and appears in three
// places — the homepage card, the teaser at the foot of /operations, and this page's wedge — and
// a number that disagreed with itself across them would undo the argument it is making. The demo
// draws its own, because that one is animated; the counts are the same and must stay so.
//
// The ungoverned tools are named rather than counted. "Five ungoverned" is a statistic; a row
// reading `ledger.adjust — nothing governs this` is the finding, and it is the same move the
// Overlay makes by picking a Refund button rather than an Add to bag.
//
// Eight tools with all eight rows on screen, rather than fourteen with half of them behind a
// footnote. A reader who can count the rows can check the headline number, and the number is
// the whole wedge — it should not require trusting an ellipsis.

export interface Props {
  /** `card` drops the chrome to fit a 4:3 tile; `full` is the standalone panel. */
  variant?: 'card' | 'full';
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;

// Counted from the list rather than written down, so the headline can never drift from the
// rows underneath it — which is the one error this panel could make that would cost it
// everything, since the number is the argument.
const tools = [
  { name: 'invoice.review', governed: true, rule: 'Review Standard' },
  { name: 'invoice.approve', governed: true, rule: 'Approval Authority' },
  { name: 'invoice.pay', governed: true, rule: 'Payment Authority' },
  { name: 'vendor.create', governed: false },
  { name: 'vendor.update', governed: false },
  { name: 'refund.issue', governed: false },
  { name: 'payment.void', governed: false },
  { name: 'ledger.adjust', governed: false },
];

const governed = tools.filter((t) => t.governed).length;
const total = tools.length;
---

<div
  class:list={['rounded-2xl border border-white/10 bg-slate-900 overflow-hidden shadow-xl flex flex-col', className]}
>
  <!-- Panel chrome, matching the Overlay's miniature so the suite reads as one system. -->
  <div class="px-3 py-2 border-b border-white/8 flex items-center gap-2 flex-shrink-0">
    <span class="text-[11px] font-semibold text-white border border-primary/60 rounded px-2 py-0.5">Inspect</span>
    <span class="text-[11px] text-slate-300 truncate">Accounts Payable Agent</span>
    <span class="ml-auto text-[9px] font-bold uppercase tracking-wider text-slate-500 whitespace-nowrap">Demo mode</span
    >
  </div>

  <div class="p-3.5 flex-1 min-h-0 flex flex-col">
    <!-- The finding, not a statistic. It leads because it is the sentence the product
         exists to say, and because a reader who reads nothing else has still read it. -->
    <p class="text-sm font-bold text-white leading-snug">
      {governed} of {total} of this agent's tools are governed by something.
    </p>
    <p class="mt-1 text-[10px] text-slate-500 leading-snug">
      The denominator is this agent's tools, so it moves per agent and per graph.
    </p>

    <div class="mt-3 flex gap-1" aria-hidden="true">
      {
        Array.from({ length: total }).map((_, i) => (
          <div class:list={['h-1.5 flex-1 rounded-full', i < governed ? 'bg-primary' : 'bg-slate-700']} />
        ))
      }
    </div>

    <div class="mt-3 space-y-1.5 flex-1 min-h-0 overflow-hidden">
      {
        tools.slice(0, variant === 'card' ? 6 : tools.length).map((t) => (
          <div
            class:list={[
              'flex items-center gap-2 rounded px-2 py-1.5',
              t.governed ? 'bg-slate-800/50' : 'bg-rose-500/5 border border-rose-400/20',
            ]}
          >
            <Icon
              name={t.governed ? 'tabler:shield-check' : 'tabler:shield-off'}
              class:list={['w-3.5 h-3.5 flex-shrink-0', t.governed ? 'text-primary' : 'text-rose-300']}
            />
            <span class="text-[11px] font-mono text-slate-300 truncate">{t.name}</span>
            <span
              class:list={[
                'ml-auto text-[10px] truncate text-right',
                t.governed ? 'text-slate-500' : 'text-rose-300/90',
              ]}
            >
              {t.governed ? t.rule : 'nothing governs this'}
            </span>
          </div>
        ))
      }
    </div>

    {
      variant === 'full' && (
        <p class="mt-3 pt-3 border-t border-white/8 text-[10px] text-slate-500 leading-snug">
          Every tool this agent has, and nothing hidden. <span class="text-rose-300/90">payment.void</span> and
          <span class="text-rose-300/90">ledger.adjust</span> can both move money out, and neither has a rule about who
          may.
        </p>
      )
    }
  </div>
</div>
