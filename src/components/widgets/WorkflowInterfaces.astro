---
import { twMerge } from 'tailwind-merge';

// Figure for "Interfaces for Workflows" in the Execution Model post.
//
// Compose operations into a Submit Order path. Each step is noun · verb, with
// the actor on the right. After Order · Create, a background fork sends the
// confirmation email while the main path routes to the confirmation page.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

type Step = {
  noun: string;
  verb: string;
  actor: string;
  kind: string;
  note?: string;
};

type Node = { type: 'step'; step: Step } | { type: 'fork'; label: string; steps: Step[] };

const nodes: Node[] = [
  {
    type: 'step',
    step: {
      noun: 'Order',
      verb: 'Validate',
      actor: 'Browser',
      kind: 'UI',
      note: 'Frontend validation',
    },
  },
  {
    type: 'step',
    step: {
      noun: 'Order',
      verb: 'Submit',
      actor: 'API',
      kind: 'System',
      note: 'API validation',
    },
  },
  {
    type: 'step',
    step: {
      noun: 'Order',
      verb: 'Create',
      actor: 'Order system',
      kind: 'System',
    },
  },
  {
    type: 'fork',
    label: 'Fork',
    steps: [
      {
        noun: 'Confirmation',
        verb: 'Send',
        actor: 'Mail worker',
        kind: 'System',
        note: 'Background job',
      },
      {
        noun: 'Confirmation',
        verb: 'Show',
        actor: 'Browser',
        kind: 'UI',
        note: 'Route to confirmation page',
      },
    ],
  },
];
---

<figure class={twMerge('not-prose my-10', className)} data-workflow-interfaces>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="border-b border-white/8 px-4 py-3 sm:px-5">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Workflow</p>
      <p class="mt-1 font-mono text-sm text-slate-200">Submit Order</p>
    </div>

    <div class="flow px-4 py-4 sm:px-5">
      {
        nodes.map((node, i) => (
          <>
            {node.type === 'step' && (
              <div class="step-row">
                <div class="step-main">
                  <p class="step-name">
                    <span class="step-noun">{node.step.noun}</span>
                    <span class="step-dot" aria-hidden="true">
                      ·
                    </span>
                    <span class="step-verb">{node.step.verb}</span>
                  </p>
                  {node.step.note && <p class="step-note">{node.step.note}</p>}
                </div>
                <div class="step-actor">
                  <span class="actor-name">{node.step.actor}</span>
                  <span class="actor-kind">{node.step.kind}</span>
                </div>
              </div>
            )}

            {node.type === 'fork' && (
              <div class="fork">
                <p class="fork-label">{node.label}</p>
                {node.steps.map((step) => (
                  <div class="step-row fork-step">
                    <div class="step-main">
                      <p class="step-name">
                        <span class="step-noun">{step.noun}</span>
                        <span class="step-dot" aria-hidden="true">
                          ·
                        </span>
                        <span class="step-verb">{step.verb}</span>
                      </p>
                      {step.note && <p class="step-note">{step.note}</p>}
                    </div>
                    <div class="step-actor">
                      <span class="actor-name">{step.actor}</span>
                      <span class="actor-kind">{step.kind}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}

            {i < nodes.length - 1 && (
              <span class="connector" aria-hidden="true">
                <span class="connector-line" />
              </span>
            )}
          </>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    One workflow, five operations. After Order · Create, the path forks: Confirmation · Send runs as a background job
    while Confirmation · Show routes the browser.
  </figcaption>
</figure>

<style>
  .flow {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 36rem;
    margin-inline: auto;
  }

  .step-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.75rem;
    background: rgb(30 41 59 / 0.65);
    padding: 0.75rem 0.875rem;
  }

  .step-main {
    min-width: 0;
  }

  .step-name {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .step-noun {
    color: rgb(226 232 240);
  }

  .step-dot {
    margin-inline: 0.35rem;
    color: rgb(100 116 139);
  }

  .step-verb {
    color: rgb(45 212 191);
    font-weight: 600;
  }

  .step-note {
    margin: 0.25rem 0 0;
    color: rgb(148 163 184);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .step-actor {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.15rem;
    flex-shrink: 0;
    text-align: right;
  }

  .actor-name {
    color: rgb(226 232 240);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .actor-kind {
    color: rgb(100 116 139);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fork {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px dashed rgb(45 212 191 / 0.45);
    border-radius: 0.875rem;
    background: rgb(13 148 136 / 0.07);
    padding: 0.625rem;
  }

  .fork-label {
    margin: 0;
    color: rgb(45 212 191);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }

  .fork-step {
    background: rgb(15 23 42 / 0.55);
  }

  .connector {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .connector-line {
    width: 2px;
    height: 1.1rem;
    background: linear-gradient(to bottom, rgb(45 212 191 / 0.15), rgb(45 212 191 / 0.85));
    position: relative;
  }

  .connector-line::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-right: 2px solid rgb(45 212 191);
    border-bottom: 2px solid rgb(45 212 191);
    transform: rotate(45deg);
  }
</style>
