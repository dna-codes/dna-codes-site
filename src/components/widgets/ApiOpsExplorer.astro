---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { Icon } from 'astro-icon/components';
import { rowStyle, pillStyle } from '~/utils/openapi-ui';

// §4 — the explorer, and the objection the reader has held since the headline.
//
// It concedes Swagger in the first line, and that is the argument rather than politeness: the moment
// this page implies we ship a better documentation tool, it is in a fight over taste against
// something developers already like, and it loses.
//
// The visual used to be a still of Swagger's Try it out panel with a DNA block wedged into it. It
// read as "we render inside Swagger", which is the one thing the copy beside it spends three
// paragraphs denying. It is a two-tab switcher now, and the switching is the argument:
//
//   - The endpoint header is byte-identical in both tabs. Same method pill, same path, same summary,
//     because both are readings of the same OpenAPI document — the one the team already publishes.
//   - Each tab carries a link to the other, in the corner where a real product would put it. Going
//     back and forth costs one click, which is what "alongside, not instead of" has to feel like.
//   - Swagger's tab is not a caricature. It shows the parameters and the response codes it actually
//     shows, because a strawman version of the tool a visitor likes discredits the page, not Swagger.
//
// The actor switcher is the payload. Same endpoint, same document, three people: the verdict and the
// Execute button change, and the reason is named rather than reduced to a status code. That is the
// whole difference between documentation and an operational console, demonstrated instead of
// asserted.

const ACTORS = [
  {
    id: 'dana',
    name: 'Dana Ruiz',
    seat: 'Finance.Admin',
    may: true,
    checks: [
      { label: 'Authorization', value: 'Payment.Refund', ok: true },
      { label: 'Scope', value: 'Northwind Ltd', ok: true },
      { label: 'Feature', value: 'refunds_v2 · on', ok: true },
      { label: 'Limit', value: '$240.00 of $5,000', ok: true },
    ],
    note: 'Dana may. The record will name her and the authority she used, not the API key she sent.',
  },
  {
    id: 'sam',
    name: 'Sam Okonkwo',
    seat: 'Support.Agent',
    may: false,
    checks: [
      { label: 'Authorization', value: 'Payment.Refund', ok: false },
      { label: 'Scope', value: 'Northwind Ltd', ok: true },
      { label: 'Feature', value: 'refunds_v2 · on', ok: true },
      { label: 'Limit', value: 'not reached', ok: null },
    ],
    note: 'Support may read a payment and may not refund one. There is no button to press, and the attempt is recorded anyway.',
  },
  {
    id: 'batch',
    name: 'nightly-recon',
    seat: 'Service account',
    may: false,
    checks: [
      { label: 'Authorization', value: 'Payment.Refund', ok: true },
      { label: 'Scope', value: 'Northwind Ltd', ok: true },
      { label: 'Feature', value: 'refunds_v2 · off for jobs', ok: false },
      { label: 'Limit', value: 'not reached', ok: null },
    ],
    note: 'The flag runs before the rule. This job holds the grant and still gets nothing, because the feature is not on for it.',
  },
];

// What Swagger's own panel shows for this operation. Real response codes, because the point of the
// left tab is that it is the document a team already has rather than a diagram of one.
const RESPONSES = [
  { code: '200', desc: 'Refund created' },
  { code: '402', desc: 'Insufficient balance' },
  { code: '404', desc: 'Payment not found' },
];
---

<WidgetWrapper containerClass="max-w-6xl mx-auto">
  <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
    <div data-api-explorer data-view="swagger" data-actor="dana">
      {
        /* One tablist over both readings. Swagger first, and selected by default, because that is
          the thing the visitor already has — the page opens on their world, not ours. */
      }
      <div
        role="tablist"
        aria-label="Two readings of one endpoint"
        class="mb-3 inline-flex gap-1 rounded-xl border border-white/10 bg-slate-900/60 p-1"
      >
        <button role="tab" data-view-tab="swagger" aria-selected="true" class="view-tab">Swagger UI</button>
        <button role="tab" data-view-tab="dna" aria-selected="false" class="view-tab">DNA</button>
      </div>

      <div class="rounded-lg overflow-hidden shadow-xl" style={rowStyle()}>
        {/* Identical in both readings, deliberately: one document, two panels reading it. */}
        <div class="flex items-center gap-3 px-3 py-2.5">
          <span
            class="rounded px-2 py-1 text-[12px] font-bold text-white w-16 text-center flex-shrink-0"
            style={pillStyle()}
          >
            POST
          </span>
          <span class="font-mono text-[14px] text-white truncate">/v1/payments/{'{id}'}/refund</span>
          <span class="ml-auto hidden sm:inline text-[12px] text-slate-400 truncate">Refund a payment</span>
        </div>

        <!-- ── Swagger's reading ───────────────────────────────────────── -->
        <div data-view-panel="swagger" class="bg-slate-950/60 px-3 py-3">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[12px] rounded border border-slate-500 px-2 py-0.5 text-slate-300">Try it out</span>
            <button data-goto="dna" class="ml-auto text-[12px] font-semibold text-primary hover:text-accent">
              View in DNA →
            </button>
          </div>

          <p class="text-[13px] font-semibold text-slate-400 mb-1.5">Parameters</p>
          <div class="flex gap-3 mb-3">
            <span class="text-[13px] font-mono text-slate-300 w-20">id</span>
            <span class="text-[13px] font-mono text-slate-200">pay_4c81</span>
          </div>

          <p class="text-[13px] font-semibold text-slate-400 mb-1.5">Responses</p>
          <div class="mb-3 space-y-1">
            {
              RESPONSES.map((r) => (
                <div class="flex gap-3">
                  <span class="text-[13px] font-mono text-slate-300 w-20">{r.code}</span>
                  <span class="text-[13px] text-slate-400">{r.desc}</span>
                </div>
              ))
            }
          </div>

          <button
            type="button"
            disabled
            class="w-full rounded bg-slate-600/70 px-4 py-2 text-[14px] font-semibold text-white cursor-default"
          >
            Execute
          </button>

          <p class="mt-2.5 text-[12px] text-slate-400 leading-snug">
            It will tell you what came back. It cannot tell you whether you should have pressed it.
          </p>
        </div>

        <!-- ── The operational reading of the same document ─────────────── -->
        <div data-view-panel="dna" class="bg-slate-950/60 px-3 py-3" hidden>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-[12px] rounded border border-primary/60 px-2 py-0.5 text-primary font-semibold">
              May I?
            </span>
            <button data-goto="swagger" class="ml-auto text-[12px] font-semibold text-primary hover:text-accent">
              Go to Swagger →
            </button>
          </div>

          <p class="text-[13px] font-semibold text-slate-400 mb-1.5">Acting as</p>
          <div class="mb-3 flex flex-wrap gap-1.5">
            {
              ACTORS.map((a) => (
                <button data-actor-tab={a.id} class="actor-tab rounded px-2 py-1 text-[12px]">
                  {a.name} <span class="opacity-70">· {a.seat}</span>
                </button>
              ))
            }
          </div>

          {
            ACTORS.map((a) => (
              <div data-actor-panel={a.id} hidden>
                <div class="space-y-1 mb-3">
                  {a.checks.map((c) => (
                    <div class="flex items-center gap-2">
                      <Icon
                        name={c.ok === null ? 'tabler:minus' : c.ok ? 'tabler:check' : 'tabler:x'}
                        class:list={[
                          'w-3 h-3 flex-shrink-0',
                          c.ok === null ? 'text-slate-600' : c.ok ? 'text-primary' : 'text-rose-400',
                        ]}
                      />
                      <span class="text-[13px] text-slate-400 w-24 flex-shrink-0">{c.label}</span>
                      <span
                        class:list={[
                          'text-[13px] font-mono truncate',
                          c.ok === null ? 'text-slate-600' : c.ok ? 'text-slate-200' : 'text-rose-300',
                        ]}
                      >
                        {c.value}
                      </span>
                    </div>
                  ))}
                </div>

                {/* The refusal has no Execute button rather than a disabled one: a control you can
                    press and be told off by is the behaviour this product exists to replace. */}
                {a.may ? (
                  <button
                    type="button"
                    disabled
                    class="w-full rounded bg-primary/90 px-4 py-2 text-[14px] font-semibold text-white cursor-default"
                  >
                    Execute
                  </button>
                ) : (
                  <div class="w-full rounded border border-dashed border-rose-400/40 bg-rose-500/8 px-4 py-2 text-center text-[13px] font-semibold text-rose-300">
                    Nothing to press
                  </div>
                )}

                <p class="mt-2.5 text-[12px] text-slate-400 leading-snug">{a.note}</p>
              </div>
            ))
          }
        </div>
      </div>

      <p class="mt-3 text-[12px] text-slate-500 leading-snug">
        One OpenAPI document. Two panels reading it, and one click between them.
      </p>
    </div>

    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-primary mb-4">The explorer</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-5">
        Swagger documents.<br />DNA <span class="text-accent">operates</span>.
      </h2>
      <p class="text-muted leading-relaxed mb-4">
        <strong class="text-white">Keep Swagger UI.</strong> We do not render into it and we do not replace it — we read the
        same document it reads, and sit beside it with a link in each direction.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Nothing about your API changes either. The controls sit on top of the endpoints you already run: one middleware
        in front of your existing handlers, or one call inside a handler that needs the decision mid-body. No gateway to
        adopt, no routes to move, no rewrite.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Documentation asks <em>what does this endpoint take</em>. An operational console asks
        <em>may I, as me, right now</em> — and answers before you press, not with a status code afterwards.
      </p>
      <p class="text-muted leading-relaxed">
        The smallest version is one link in the Swagger page you already have:
        <code class="text-white">View in DNA →</code>. It costs a day, and it tells us whether anyone wants the panel.
      </p>
    </div>
  </div>
</WidgetWrapper>

<style>
  .view-tab,
  .actor-tab {
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .view-tab {
    border-radius: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-size: 13px;
    font-weight: 600;
    color: rgb(148 163 184);
  }
  .view-tab:hover {
    color: rgb(226 232 240);
  }
  .view-tab[aria-selected='true'] {
    color: white;
    background-color: var(--aw-color-primary);
  }

  .actor-tab {
    border: 1px solid rgb(255 255 255 / 10%);
    background: rgb(30 41 59 / 50%);
    color: rgb(148 163 184);
  }
  .actor-tab:hover {
    color: rgb(226 232 240);
  }
  .actor-tab[aria-pressed='true'] {
    color: white;
    border-color: rgb(13 148 136 / 60%);
    background: rgb(13 148 136 / 18%);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-api-explorer]').forEach((root) => {
    const viewTabs = Array.from(root.querySelectorAll<HTMLElement>('[data-view-tab]'));
    const viewPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-view-panel]'));
    const actorTabs = Array.from(root.querySelectorAll<HTMLElement>('[data-actor-tab]'));
    const actorPanels = Array.from(root.querySelectorAll<HTMLElement>('[data-actor-panel]'));

    const setView = (id: string) => {
      root.dataset.view = id;
      viewTabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.viewTab === id)));
      viewPanels.forEach((p) => (p.hidden = p.dataset.viewPanel !== id));
    };

    const setActor = (id: string) => {
      root.dataset.actor = id;
      actorTabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.actorTab === id)));
      actorPanels.forEach((p) => (p.hidden = p.dataset.actorPanel !== id));
    };

    viewTabs.forEach((t) => t.addEventListener('click', () => setView(t.dataset.viewTab!)));
    // The in-panel links are the point of the section — crossing over has to cost one click from
    // inside the panel, not a trip back up to the tabs.
    root
      .querySelectorAll<HTMLElement>('[data-goto]')
      .forEach((a) => a.addEventListener('click', () => setView(a.dataset.goto!)));
    actorTabs.forEach((t) => t.addEventListener('click', () => setActor(t.dataset.actorTab!)));

    setView(root.dataset.view ?? 'swagger');
    setActor(root.dataset.actor ?? 'dana');
  });
</script>
