---
import { twMerge } from 'tailwind-merge';

// Figure for "The Execution Model: A Mirror of Business Operations".
//
// One operation, four interfaces. Super simple table: same Pay Invoice on the
// left, the surface that runs it on the right. Visual interfaces render as UI
// (a real button); the rest are light surface chips.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rows = [
  {
    operation: 'Pay Invoice',
    kind: 'Button',
    visual: 'button' as const,
  },
  {
    operation: 'Pay Invoice',
    kind: 'REST endpoint',
    visual: 'endpoint' as const,
    detail: 'POST /invoices/:id/pay',
  },
  {
    operation: 'Pay Invoice',
    kind: 'Workflow step',
    visual: 'step' as const,
    detail: 'Pay Invoice',
  },
  {
    operation: 'Pay Invoice',
    kind: 'Agent tool',
    visual: 'tool' as const,
    detail: 'pay_invoice',
  },
];
---

<figure class={twMerge('not-prose my-10', className)} data-interface-projection>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="border-b border-white/8 px-4 py-3 sm:px-5">
      <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Operation</p>
      <p class="mt-1 font-mono text-sm text-slate-200">
        Customer → Pay → Invoice <span class="text-slate-500">·</span>
        <span class="text-teal-200">status = Issued</span>
        <span class="text-slate-500">·</span>
        <span class="text-teal-200">amount required</span>
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-white/8 text-[11px] font-bold uppercase tracking-wider text-slate-500">
            <th class="px-4 py-2.5 font-bold sm:px-5" scope="col">Operation</th>
            <th class="px-4 py-2.5 font-bold sm:px-5" scope="col">Interface</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-white/5 last:border-0">
                <td class="px-4 py-4 align-middle font-mono text-sm text-primary sm:px-5">{row.operation}</td>
                <td class="px-4 py-4 align-middle sm:px-5">
                  <div class="flex items-center justify-between gap-4">
                    <div class="min-w-0">
                      {row.visual === 'button' && (
                        <button
                          type="button"
                          title={row.kind}
                          class="rounded-md bg-primary px-3.5 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-secondary focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                        >
                          Pay Invoice
                        </button>
                      )}
                      {row.visual === 'endpoint' && (
                        <code
                          title={row.kind}
                          class="rounded-md border border-white/10 bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-200"
                        >
                          {row.detail}
                        </code>
                      )}
                      {row.visual === 'step' && (
                        <span
                          title={row.kind}
                          class="inline-flex items-center gap-2 rounded-md border border-teal-400/30 bg-teal-400/10 px-2.5 py-1 text-xs font-semibold text-teal-200"
                        >
                          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-teal-400/20 text-[10px] font-bold text-teal-200">
                            3
                          </span>
                          {row.detail}
                        </span>
                      )}
                      {row.visual === 'tool' && (
                        <code
                          title={row.kind}
                          class="rounded-md border border-white/10 bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-200"
                        >
                          {row.detail}()
                        </code>
                      )}
                    </div>
                    <span class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                      {row.kind}
                    </span>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    Same operation. Four interfaces. A button, an endpoint, a workflow step, and a tool an agent can call.
  </figcaption>
</figure>
