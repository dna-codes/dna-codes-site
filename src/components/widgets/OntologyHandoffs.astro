---
import { twMerge } from 'tailwind-merge';

// Handoff graphic for the Ontology post: meaning → structure → behavior.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const steps = [
  {
    layer: 'Semantics',
    role: 'Meaning',
    detail: 'What the words refer to',
    tag: 'In',
  },
  {
    layer: 'Ontology',
    role: 'Structure',
    detail: 'What exists, and how it connects',
    tag: 'This layer',
    current: true,
  },
  {
    layer: 'Operational Model',
    role: 'Behavior',
    detail: 'What may happen to it',
    tag: 'Out',
  },
];
---

<figure class={twMerge('not-prose my-10', className)}>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="flex flex-col gap-px bg-white/8 sm:flex-row sm:items-stretch">
      {
        steps.map((step, i) => (
          <>
            <div
              class:list={[
                'flex-1 p-4 sm:p-5',
                step.current ? 'bg-primary/15 ring-1 ring-inset ring-primary/50' : 'bg-slate-900/90',
              ]}
            >
              <p
                class:list={[
                  'text-[10px] font-bold uppercase tracking-widest',
                  step.current ? 'text-primary' : 'text-slate-500',
                ]}
              >
                {step.tag}
              </p>
              <p
                class:list={[
                  'mt-2 font-semibold',
                  step.current ? 'text-base text-primary sm:text-lg' : 'text-sm text-slate-200',
                ]}
              >
                {step.layer}
              </p>
              <p
                class:list={[
                  'mt-1 font-mono',
                  step.current ? 'text-sm font-semibold text-teal-200' : 'text-xs text-primary/90',
                ]}
              >
                {step.role}
              </p>
              <p
                class:list={[
                  'mt-2 leading-relaxed',
                  step.current ? 'text-xs text-slate-300' : 'text-[11px] text-slate-400',
                ]}
              >
                {step.detail}
              </p>
            </div>
            {i < steps.length - 1 && (
              <div
                class="flex items-center justify-center bg-slate-900/90 px-2 py-1 text-primary sm:px-1"
                aria-hidden="true"
              >
                <span class="sm:hidden">↓</span>
                <span class="hidden sm:inline">→</span>
              </div>
            )}
          </>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    Semantics hands Ontology meaning. Ontology hands the Operational Model structure. Behavior is the next layer's job.
  </figcaption>
</figure>
