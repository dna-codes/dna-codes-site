---
// Act III — the payoff.
//
// One pane, and the tabs arrive one at a time as their lens resolves. That is the whole staging
// decision: a grid of twelve cards dropping in is a wall, and a visitor cannot tell what they
// are looking at. A pane whose tab strip grows in front of you reads as something being built,
// and it keeps a single artifact at full size instead of twelve at a twelfth of the attention.
//
// The pane follows each new tab as it lands, until the visitor picks one themselves — then it
// stops moving under them for the rest of the run.
//
// The pacing is theatre and the code says so out loud; the *content* never is. Every panel is a
// real derivation over the compiled genome the browser fetched, and the demo-mode badge plus the
// named genome stay on screen throughout, so nobody leaves thinking we ran this against their
// own company.
import { Icon } from 'astro-icon/components';
import { APP_HREF } from '~/navigation';
import { WAITLIST_HREF } from '~/navigation';
---

<section id="act-generate" class="relative bg-slate-950 py-14 sm:py-20" aria-labelledby="act-generate-h">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-2 text-center text-xs font-bold uppercase tracking-widest text-primary">Step three</div>
    <h2 id="act-generate-h" class="text-center text-2xl font-bold tracking-tight text-white sm:text-4xl">
      One genome. Endless lenses.
    </h2>

    <!-- The tab strip is the progress indicator, so this line only has to carry what the strip
         cannot: a name for the stage, and an announcement for anyone not watching it. -->
    <p id="generate-status" class="mt-5 text-center text-sm text-primary" hidden aria-live="polite"></p>

    <!-- Two muted lines, no badge. The badge went, but the disclosure did not: "not your data"
         is the whole point of it, and it survives in words.
         The vocabularies stay inline rather than behind an info icon — see the note in the
         design. They are the strongest credibility signal on the page for a domain buyer, and
         hover reaches neither touch nor keyboard. -->
    <div id="generate-meta" class="mt-5 text-center" hidden>
      <p class="text-xs text-slate-400">
        <strong id="generate-genome-name" class="text-slate-200"></strong> — a worked genome, not your data.
      </p>
      <p id="generate-ontologies" class="mt-1 text-xs text-slate-500"></p>
    </div>

    <!-- Before Go: the shape of what is coming, rather than an empty frame that reads as
         broken or a heading with nothing under it. Purely decorative, so it is hidden from
         assistive technology — a screen reader gains nothing from five grey rectangles. -->
    <div id="generate-skeleton" class="gx-pane mt-7">
      <div class="gx-tabs gx-skel-fill" aria-hidden="true">
        {[7, 5, 6, 4, 6].map((w) => <span class="gx-skel gx-skel-tab" style={`width:${w}rem`} />)}
      </div>
      <div class="gx-pane-body gx-skel-body">
        {/* Decorative only — the bars are shape, not information. */}
        <div class="gx-skel-fill" aria-hidden="true">
          <div class="gx-skel gx-skel-title"></div>
          <div class="gx-skel-lines">
            {[96, 88, 74, 91, 62, 84, 70].map((w) => <span class="gx-skel gx-skel-line" style={`width:${w}%`} />)}
          </div>
        </div>
        {
          /* The prompt sits inside the frame rather than above it, so the skeleton reads as an
            instruction instead of a blank grey box. It stays outside the aria-hidden wrapper —
            it is the one part of this that is real information. */
        }
        <p id="generate-idle" class="gx-skel-prompt">
          <span>
            Press <strong class="text-slate-100">Go</strong> and this fills in.
          </span>
        </p>
      </div>
    </div>

    <div id="generate-pane" class="gx-pane mt-7" hidden>
      <div id="artifact-tabs" class="gx-tabs" role="tablist" aria-label="Generated artifacts"></div>
      <div id="artifact-panels" class="gx-pane-body"></div>
    </div>

    <!-- The artifacts have already made the argument; a paragraph restating it after they land
         is the page explaining a joke it just told. Straight to the action. -->
    <div id="generate-summary" class="mt-9 text-center" hidden>
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          id="create-dna-cta"
          href={APP_HREF}
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-8 py-3.5 text-base font-bold text-white shadow-[0_0_36px_rgba(13,148,136,0.45)] transition hover:bg-primary/85"
        >
          <Icon name="tabler:dna-2" class="h-4 w-4" />
          Create your DNA
        </a>
        <a
          href={WAITLIST_HREF}
          class="text-sm font-medium text-slate-400 underline-offset-4 hover:text-slate-200 hover:underline"
        >
          Or join the waitlist
        </a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* The pane, and the tab strip that grows in front of you ------------------ */
  .gx-pane {
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(15, 23, 42, 0.75);
    overflow: hidden;
    box-shadow: 0 0 48px rgba(13, 148, 136, 0.14);
  }
  .gx-tabs {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.5rem 0;
    overflow-x: auto;
    background: rgba(2, 6, 23, 0.55);
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    scrollbar-width: thin;
  }
  .gx-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem 0.5rem 0 0;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgb(148 163 184);
    white-space: nowrap;
    cursor: pointer;
    border: 1px solid transparent;
    border-bottom: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
    /* Each tab arrives as its lens resolves — this is the "building" the visitor watches. */
    animation: gx-tab-in 0.28s ease both;
  }
  .gx-tab:hover {
    color: rgb(226 232 240);
    background: rgba(255, 255, 255, 0.04);
  }
  .gx-tab[aria-selected='true'] {
    color: rgb(241 245 249);
    background: rgba(15, 23, 42, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 2px 0 var(--aw-color-primary, #0d9488);
  }
  .gx-tab-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  /* One colour per DNA layer, so the strip shows at a glance that all three are represented. */
  .gx-tab-dot[data-layer='operations'] {
    background: rgb(45 212 191);
  }
  .gx-tab-dot[data-layer='product'] {
    background: rgb(96 165 250);
  }
  .gx-tab-dot[data-layer='technology'] {
    background: rgb(192 132 252);
  }
  @keyframes gx-tab-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* A tab still waiting on its lens: present, named, and visibly not ready. */
  .gx-tab[data-pending] {
    opacity: 0.45;
    cursor: default;
  }
  .gx-tab[data-pending] .gx-tab-dot {
    animation: gx-pulse 1.1s ease-in-out infinite;
  }
  @keyframes gx-pulse {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  .gx-pane-body {
    padding: 1rem;
    min-height: 18rem;
  }

  /* Skeleton ---------------------------------------------------------------- */
  /* The dimming belongs to the decorative bars, not the whole frame — the prompt sitting inside
     it has to stay fully legible. */
  .gx-skel-fill {
    opacity: 0.45;
  }
  .gx-skel-body {
    position: relative;
  }
  .gx-skel-prompt {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    text-align: center;
    font-size: 1rem;
    color: rgb(148 163 184);
  }
  /* A scrim behind the words so they read cleanly over the bars underneath. */
  .gx-skel-prompt > span {
    border-radius: 0.75rem;
    background: rgb(15 23 42 / 0.82);
    backdrop-filter: blur(3px);
    padding: 0.7rem 1.1rem;
    border: 1px solid rgb(148 163 184 / 0.18);
  }
  .gx-skel {
    display: block;
    border-radius: 0.4rem;
    background: linear-gradient(
      90deg,
      rgb(148 163 184 / 0.1) 25%,
      rgb(148 163 184 / 0.2) 37%,
      rgb(148 163 184 / 0.1) 63%
    );
    background-size: 400% 100%;
    animation: gx-shimmer 1.6s ease-in-out infinite;
  }
  .gx-skel-tab {
    height: 1.5rem;
    flex-shrink: 0;
    margin-bottom: 0.5rem;
    border-radius: 0.4rem 0.4rem 0 0;
  }
  .gx-skel-title {
    width: 11rem;
    height: 1rem;
    margin-bottom: 1.1rem;
  }
  .gx-skel-lines {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .gx-skel-line {
    height: 0.7rem;
  }
  @keyframes gx-shimmer {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0 50%;
    }
  }
  .gx-panel[hidden] {
    display: none;
  }
  .gx-panel-head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gx-panel-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: rgb(241 245 249);
  }
  .gx-panel-desc {
    font-size: 0.72rem;
    color: rgb(100 116 139);
  }
  .gx-panel-layer {
    margin-left: auto;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--aw-color-primary, #0d9488);
  }
  .gx-panel-body {
    font-size: 0.8rem;
    color: rgb(203 213 225);
  }
  .gx-error {
    color: rgb(252 165 165);
    font-size: 0.78rem;
  }
  .gx-working {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 12rem;
    font-size: 0.78rem;
    color: rgb(100 116 139);
  }

  /* Shared artifact primitives --------------------------------------------- */
  .gx-lede {
    font-size: 0.75rem;
    color: rgb(148 163 184);
    margin-bottom: 0.75rem;
  }
  .gx-foot {
    margin-top: 0.75rem;
    font-size: 0.68rem;
    color: rgb(100 116 139);
  }
  .gx-empty {
    font-size: 0.72rem;
    color: rgb(100 116 139);
    font-style: italic;
  }
  .gx-k {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgb(100 116 139);
    margin-bottom: 0.15rem;
  }
  .gx-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    border-radius: 0.4rem;
    border: 1px solid rgba(13, 148, 136, 0.35);
    background: rgba(13, 148, 136, 0.12);
    padding: 0.1rem 0.4rem;
    font-size: 0.66rem;
    color: rgb(153 246 228);
    margin: 0.1rem 0.15rem 0.1rem 0;
  }
  .gx-chip-sub {
    color: rgb(94 234 212);
    opacity: 0.7;
    font-size: 0.6rem;
  }
  .gx-block {
    display: inline-block;
    border-radius: 0.35rem;
    border: 1px solid rgba(148, 163, 184, 0.28);
    padding: 0.05rem 0.35rem;
    font-size: 0.62rem;
    color: rgb(148 163 184);
    margin: 0.1rem 0.15rem 0.1rem 0;
  }
  .gx-panel-body code {
    font-size: 0.66rem;
    color: rgb(94 234 212);
    background: rgba(13, 148, 136, 0.1);
    border-radius: 0.25rem;
    padding: 0.05rem 0.3rem;
  }
  .gx-scroll {
    overflow-x: auto;
  }
  .gx-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.7rem;
  }
  .gx-table th {
    text-align: left;
    font-weight: 700;
    color: rgb(148 163 184);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.35rem 0.5rem;
    white-space: nowrap;
  }
  .gx-table td {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.35rem 0.5rem;
    color: rgb(203 213 225);
    white-space: nowrap;
  }
  .gx-sticky-col {
    position: sticky;
    left: 0;
    background: rgb(15 23 42);
    z-index: 1;
  }

  /* Process flow ------------------------------------------------------------ */
  .gx-flow-steps {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .gx-flow-step {
    display: flex;
    gap: 0.6rem;
    border-left: 2px solid rgba(13, 148, 136, 0.4);
    padding: 0.3rem 0 0.3rem 0.7rem;
  }
  .gx-flow-index {
    flex-shrink: 0;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 9999px;
    background: rgba(13, 148, 136, 0.2);
    border: 1px solid rgba(13, 148, 136, 0.5);
    color: rgb(94 234 212);
    font-size: 0.62rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gx-flow-title {
    font-weight: 600;
    color: rgb(241 245 249);
    font-size: 0.78rem;
  }
  .gx-flow-desc {
    font-size: 0.7rem;
    color: rgb(148 163 184);
    margin-top: 0.1rem;
  }
  .gx-flow-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .gx-owner {
    font-size: 0.65rem;
    font-weight: 600;
    color: rgb(94 234 212);
  }

  /* SOP --------------------------------------------------------------------- */
  .gx-sop-head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    color: rgb(203 213 225);
  }
  .gx-sop-steps {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .gx-sop-title {
    font-weight: 600;
    color: rgb(241 245 249);
    font-size: 0.76rem;
  }
  .gx-sop-n {
    color: var(--aw-color-primary, #0d9488);
    font-weight: 700;
  }
  .gx-sop-instruction {
    font-size: 0.7rem;
    color: rgb(148 163 184);
    margin-top: 0.1rem;
  }
  .gx-sop-actor {
    font-size: 0.65rem;
    color: rgb(100 116 139);
    margin-top: 0.15rem;
  }

  /* Key positions ----------------------------------------------------------- */
  .gx-pos-tree,
  .gx-pos-children {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gx-pos-children {
    margin-left: 1rem;
    padding-left: 0.75rem;
    border-left: 1px solid rgba(148, 163, 184, 0.25);
    margin-top: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .gx-pos-box {
    border-radius: 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    background: rgba(2, 6, 23, 0.4);
    padding: 0.45rem 0.6rem;
  }
  .gx-pos-name {
    font-weight: 600;
    font-size: 0.76rem;
    color: rgb(241 245 249);
  }
  .gx-pos-desc {
    font-size: 0.68rem;
    color: rgb(148 163 184);
    margin-top: 0.1rem;
  }
  .gx-pos-owns {
    margin-top: 0.3rem;
  }

  /* RACI / ACL -------------------------------------------------------------- */
  .gx-raci-mark {
    display: inline-flex;
    width: 1.2rem;
    height: 1.2rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.3rem;
    font-size: 0.6rem;
    font-weight: 800;
  }
  .gx-raci-R {
    background: rgba(13, 148, 136, 0.75);
    color: white;
  }
  .gx-raci-A {
    background: rgba(217, 119, 6, 0.7);
    color: white;
  }
  .gx-raci-C {
    background: rgba(100, 116, 139, 0.4);
    color: rgb(226 232 240);
  }
  .gx-acl-yes {
    color: rgb(45 212 191);
    font-weight: 700;
  }
  .gx-acl-rule {
    display: block;
    font-size: 0.58rem;
    color: rgb(100 116 139);
  }
  .gx-ungoverned {
    margin-top: 0.85rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(248, 113, 113, 0.3);
    background: rgba(248, 113, 113, 0.07);
    padding: 0.6rem 0.7rem;
  }

  /* Rules ------------------------------------------------------------------- */
  .gx-rules {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .gx-rule {
    border-radius: 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(2, 6, 23, 0.4);
    padding: 0.6rem 0.7rem;
  }
  .gx-rule-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gx-rule-name {
    font-weight: 600;
    font-size: 0.76rem;
    color: rgb(241 245 249);
  }
  .gx-badge {
    border-radius: 0.3rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .gx-badge-access {
    background: rgba(13, 148, 136, 0.25);
    color: rgb(94 234 212);
  }
  .gx-badge-condition {
    background: rgba(217, 119, 6, 0.2);
    color: rgb(252 211 77);
  }
  .gx-rule-desc {
    font-size: 0.7rem;
    color: rgb(148 163 184);
    margin: 0.25rem 0;
  }
  .gx-rule-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  /* Data model -------------------------------------------------------------- */
  .gx-entities {
    display: grid;
    gap: 0.6rem;
  }
  .gx-entity {
    border-radius: 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: rgba(2, 6, 23, 0.4);
    padding: 0.6rem 0.7rem;
  }
  .gx-entity-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  .gx-entity-name {
    font-weight: 700;
    font-size: 0.78rem;
    color: rgb(241 245 249);
  }
  .gx-entity-desc {
    font-size: 0.68rem;
    color: rgb(148 163 184);
    margin: 0.2rem 0 0.35rem;
  }
  .gx-fields {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .gx-fields li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.68rem;
  }
  .gx-field-name {
    color: rgb(226 232 240);
    font-weight: 500;
  }
  .gx-field-type {
    color: rgb(94 234 212);
    font-size: 0.62rem;
  }
  .gx-req {
    font-size: 0.55rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(251 146 60);
  }
  .gx-field-values {
    font-size: 0.6rem;
    color: rgb(100 116 139);
  }

  /* Screen map -------------------------------------------------------------- */
  .gx-screens {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .gx-screen {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    border-radius: 0.55rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    padding: 0.45rem 0.6rem;
  }
  .gx-route {
    flex-shrink: 0;
  }
  .gx-screen-title {
    font-weight: 600;
    font-size: 0.74rem;
    color: rgb(241 245 249);
  }
  .gx-screen-desc {
    font-size: 0.66rem;
    color: rgb(148 163 184);
  }
  .gx-screen-meta {
    margin-top: 0.2rem;
  }
  .gx-lock {
    font-size: 0.6rem;
  }

  /* Example UI -------------------------------------------------------------- */
  .gx-ui {
    border-radius: 0.7rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    overflow: hidden;
    background: rgba(2, 6, 23, 0.55);
  }
  .gx-ui-chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.6rem;
    background: rgba(15, 23, 42, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .gx-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: rgba(148, 163, 184, 0.4);
  }
  .gx-ui-title {
    margin-left: 0.35rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgb(203 213 225);
  }
  .gx-ui-action {
    margin-left: auto;
    border-radius: 0.3rem;
    background: rgba(13, 148, 136, 0.3);
    padding: 0.1rem 0.4rem;
    font-size: 0.6rem;
    color: rgb(153 246 228);
  }
  .gx-ui-form {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.7rem;
  }
  .gx-ui-form-title {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(100 116 139);
    margin-bottom: 0.5rem;
  }
  .gx-form-grid {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .gx-field {
    display: block;
  }
  .gx-label {
    display: block;
    font-size: 0.62rem;
    color: rgb(148 163 184);
    margin-bottom: 0.15rem;
  }
  .gx-star {
    color: rgb(251 146 60);
    margin-left: 0.15rem;
