---
import { twMerge } from 'tailwind-merge';

// The figure for "Semantics: Software Without Meaning Is Meaningless".
//
// The article's hard part is that its bug has no villain: two services read one field,
// both behave correctly, and the system is still wrong. This shows that in one view —
// the same identifier resolving to two different customers, with neither service having
// a definition it could be contradicting.
//
// It was previously a three-way toggle (undefined / billing contact / parent account)
// that reassigned correctness underneath two services that never moved. That made the
// mechanism vivid but asked the reader to work through three states before reaching the
// point, and the point is just the discrepancy. What survives is the state the toggle
// defaulted to, which was always the sharpest one: nobody is wrong, and the dashboards
// still disagree. The caption carries that reading; the panel itself just shows the two
// resolutions, so the point is not made twice.
//
// Static by design — no toggle, so no script, and nothing to degrade without JS.

const services = [
  {
    name: 'Billing service',
    does: "Records whoever's card was charged.",
    resolves: 'Dana Reyes',
    kind: 'person · 1 of 40 at Acme',
  },
  {
    name: 'Reporting service',
    does: 'Records whoever signed the contract.',
    resolves: 'Acme Corp',
    kind: 'account · holds the contract',
  },
];

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class={twMerge('not-prose my-10', className)}>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="border-b border-white/8 p-3 sm:px-4">
      <span class="text-xs font-bold uppercase tracking-widest text-primary">One word, two readings</span>
    </div>

    <!-- The shared artifact: the only thing actually written down -->
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-white/8 px-4 py-3 sm:px-5">
      <code class="font-mono text-sm text-slate-200">invoice_4471.customer_id</code>
      <code class="font-mono text-sm text-slate-500">= 8f2a91c4…</code>
      <span class="ml-auto text-[11px] uppercase tracking-wider text-slate-500">The only thing written down</span>
    </div>

    <!-- One value, two resolutions -->
    <div class="grid gap-px bg-white/8 sm:grid-cols-2">
      {
        services.map((s) => (
          <div class="bg-slate-900/90 p-4 sm:p-5">
            <p class="text-sm font-semibold text-slate-200">{s.name}</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-400">{s.does}</p>
            <p class="mt-3 font-mono text-sm text-primary">→ {s.resolves}</p>
            <p class="mt-0.5 text-[11px] text-slate-500">{s.kind}</p>
            <span class="verdict mt-3">Correct, by its own reading</span>
          </div>
        ))
      }
    </div>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    Same field, same value, two different customers — and nothing written down anywhere that either service could be
    getting wrong.
  </figcaption>
</figure>

<style>
  /* Plain CSS, not @apply — Tailwind v4 needs an @reference in scoped component styles,
     and the rest of the widgets here already write these out longhand. */
  .verdict {
    background-color: rgb(255 255 255 / 0.08);
    border-radius: 0.25rem;
    color: rgb(148 163 184);
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    padding: 0.125rem 0.5rem;
    text-transform: uppercase;
  }
</style>
