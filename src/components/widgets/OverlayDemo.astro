---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logoPng from '~/assets/images/logo.png';

// A scripted miniature of the panel, built stub-first: the shape is the real panel's, the
// data is staged, and the footer says so where the live panel names the signed-in person.
//
// It plays as one story rather than a set of features. Act one reads the controls that
// already exist (Inspect); act two asks for one that does not (Prototype). Keeping both
// inside a single frame is the argument — the panel never leaves the running app, and the
// second act is only possible because the first one gave every control an address.
//
// The ungoverned exhibit is Refund, deliberately. An ungoverned "Add to cart" proves
// nothing: it *should* be ungoverned, so a reader nods and moves on. A refund button that
// anyone can reach and nothing records is the same finding with teeth — and it is what the
// prototype act then extends, so the whole hero is about one control.

const orders = [
  { id: '#4412', customer: 'A. Nunes', total: '$128.00' },
  { id: '#4411', customer: 'P. Raman', total: '$34.00' },
  { id: '#4409', customer: 'T. Reyes', total: '$212.00' },
];

// The shelf is the customer's own design system, so nothing on it is ours. Two groups is
// enough to read as "grouped the way our product is grouped" without filling the panel.
const shelf = [
  {
    group: 'Controls',
    items: [
      { name: 'Primary button', kind: 'button' },
      { name: 'Quiet button', kind: 'button', picked: true },
      { name: 'Text field', kind: 'input' },
      { name: 'Note', kind: 'label' },
    ],
  },
  {
    group: 'Back office',
    items: [
      { name: 'Orders table', kind: 'table' },
      { name: 'Status badge', kind: 'badge' },
    ],
  },
];

// The storyboard. Each step is a *state of the same frame*, so the story is told by the UI
// changing rather than by slides replacing each other.
//
// `ms` is dwell time, tuned per step rather than kept uniform. It is set by what the step
// asks a stranger to do, which is never just reading: find the ring, look at the thing it
// is around, then read the caption underneath. Pacing it to the caption alone is how this
// ended up too fast the first time — a full pass is deliberately slower than it "needs"
// to be, and anyone who wants it faster has a rail they can click.
//
// `pane` and `region` are what make it followable. Nine steps across two columns is too
// much surface for a reader to search each time the caption changes, so the half that is
// not the subject dims and the exact block being described is ringed. The one thing that
// never dims is the control under discussion — that lit button across a dimmed app is the
// whole claim of the product, so it has to survive the spotlight.
type Step = {
  act: 'inspect' | 'prototype';
  panel: string;
  control?: string;
  governed?: boolean;
  sketch?: 'placed' | 'built';
  pane: 'app' | 'panel' | 'both';
  region?: string;
  ms: number;
  lead: string;
  body: string;
};

const steps: Step[] = [
  {
    act: 'inspect',
    panel: 'empty',
    pane: 'panel',
    region: 'coverage',
    ms: 7000,
    lead: 'Open the panel on a screen you already shipped.',
    body: 'It counts what governs each control in front of you — two of these three.',
  },
  {
    act: 'inspect',
    panel: 'export',
    control: 'export',
    pane: 'panel',
    region: 'answer',
    ms: 9200,
    lead: 'Ask a control who may press it.',
    body: 'Exporting customers is the store manager&rsquo;s, and the answer is for whoever is actually looking.',
  },
  {
    act: 'inspect',
    panel: 'refund',
    control: 'refund',
    pane: 'panel',
    region: 'gap',
    ms: 10000,
    lead: 'Refund answers with nothing at all.',
    body: 'No rule, no flag, no record — anyone who reaches this screen can refund any order.',
  },
  {
    act: 'inspect',
    panel: 'refund-governed',
    control: 'refund',
    governed: true,
    pane: 'app',
    region: 'orders',
    ms: 9600,
    lead: 'So restrict it from where you found it.',
    body: 'The padlock lands on the button. No deploy, and every refund from here is recorded — refusals included.',
  },
  {
    act: 'prototype',
    panel: 'shelf',
    control: 'refund',
    governed: true,
    pane: 'panel',
    region: 'shelf',
    ms: 9600,
    lead: 'Now the control that does not exist yet.',
    body: 'The desk wants partial refunds, so pick the piece off your own shelf — your design system, not our widgets.',
  },
  {
    act: 'prototype',
    panel: 'place',
    control: 'refund',
    governed: true,
    sketch: 'placed',
    // Both halves, because placement is the one step whose subject is the *correspondence*
    // between them: the sketch in the app and the address in the panel are one fact.
    pane: 'both',
    region: 'sketch',
    ms: 10000,
    lead: 'Put it where it goes.',
    body: 'It anchors to an address — beside <code>admin.orders.refund</code> — rather than to a paragraph about which button you meant.',
  },
  {
    act: 'prototype',
    panel: 'govern',
    control: 'sketch',
    governed: true,
    sketch: 'placed',
    pane: 'panel',
    region: 'rules',
    ms: 9600,
    lead: 'Say who may press it before anybody builds it.',
    body: 'The rule is written against the act, so the control arrives governed instead of being governed later.',
  },
  {
    act: 'prototype',
    panel: 'propose',
    control: 'sketch',
    governed: true,
    sketch: 'placed',
    pane: 'panel',
    region: 'why',
    ms: 11400,
    lead: 'Hand a developer an address, not a ticket.',
    body: 'One sentence about what is missing and for whom, and the request carries everything the ticket was going to say.',
  },
  {
    act: 'prototype',
    panel: 'built',
    control: 'sketch',
    governed: true,
    sketch: 'built',
    pane: 'panel',
    region: 'proposal',
    ms: 12000,
    lead: 'A build lands, and the request marks itself delivered.',
    body: '<strong class="text-white">Built</strong> is a fact about what shipped — not a card somebody dragged. Nobody reopens anything.',
  },
];

const acts = ['inspect', 'prototype'] as const;
---

<div
  data-overlay-demo
  data-tab="inspect"
  data-sketch=""
  data-refund-governed="false"
  data-paused="false"
  data-pane-focus="panel"
  data-region="coverage"
>
  <div
    class="bg-slate-900/90 rounded-2xl border-2 border-primary shadow-[0_0_48px_rgba(13,148,136,0.35)] overflow-hidden"
  >
    <!-- Chrome. Its two regions are the same widths as the two columns below, so each
       label sits directly over the thing it names and stays there — no reveal to miss
       and nothing covering the UI it is introducing. -->
    <div class="flex border-b border-white/8">
      <div class="flex-1 flex items-center gap-2.5 px-3 py-2.5 min-w-0">
        <span class="text-xs font-bold text-slate-300 uppercase tracking-widest truncate">Juniper Lane</span>
        <span
          class="flex-shrink-0 text-[10px] font-semibold uppercase tracking-wider text-slate-300 bg-white/8 border border-white/20 rounded px-1.5 py-0.5"
          >Your app</span
        >
        <button
          data-demo-restart
          class="ml-auto flex-shrink-0 text-[11px] text-slate-500 hover:text-slate-300 transition-colors duration-150 inline-flex items-center gap-1"
        >
          <Icon name="tabler:refresh" class="w-3 h-3" /> Restart
        </button>
      </div>

      <div
        class="hidden md:flex w-[19rem] flex-shrink-0 items-center gap-2 px-3 py-2.5 border-l-2 border-primary/45 bg-primary/[0.06]"
      >
        <Image src={logoPng} alt="" width={13} height={17} style="transform:rotate(45deg)" />
        <span class="text-[10px] font-bold text-primary uppercase tracking-[0.18em]">DNA Overlay</span>
      </div>
    </div>

    <div class="flex flex-col md:flex-row min-h-[22rem]">
      <!-- The application -->
      <div data-pane="app" class="relative flex-1 p-3 sm:p-4 bg-slate-950/70">
        <span class="pane-scrim" aria-hidden="true"></span>
        <p class="text-[11px] text-slate-500 mb-3 h-4">
          <span class="when-inspect">
            <Icon name="tabler:pointer" class="w-3.5 h-3.5 inline-block -mt-0.5 mr-0.5" />
            Click a control — the panel answers for it.
          </span>
          <span class="when-prototype">
            <Icon name="tabler:crosshair" class="w-3.5 h-3.5 inline-block -mt-0.5 mr-0.5" />
            Placing a control that does not exist yet.
          </span>
        </p>

        <div class="flex gap-2 sm:gap-3">
          <!-- Nav rail -->
          <nav class="w-20 sm:w-24 flex-shrink-0 space-y-1">
            <p class="text-[9px] font-bold uppercase tracking-wider whitespace-nowrap text-slate-600 mb-1.5 px-1">
              Storefront
            </p>
            <div class="px-2 py-1.5 rounded-lg text-[11px] text-slate-500">Shop</div>
            <div class="px-2 py-1.5 rounded-lg text-[11px] text-slate-500">Cart</div>
            <p class="text-[9px] font-bold uppercase tracking-wider whitespace-nowrap text-slate-600 mb-1.5 mt-3 px-1">
              Back office
            </p>
            <div class="px-2 py-1.5 rounded-lg bg-primary/20 text-[11px] text-slate-200 font-medium">Orders</div>
            <button
              data-demo-control="fulfillment"
              class="demo-control w-full text-left px-2 py-1.5 rounded-lg text-[11px] text-slate-300 flex items-center gap-1.5"
            >
              <Icon name="tabler:lock" class="w-3 h-3 flex-shrink-0 text-slate-500" />
              Fulfillment
            </button>
          </nav>

          <!-- Orders table -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <p class="text-sm font-bold text-white">Orders</p>
              <button
                data-demo-control="export"
                class="demo-control ml-auto rounded border border-white/15 px-2 py-1 text-[10px] text-slate-300 inline-flex items-center gap-1"
              >
                <Icon name="tabler:lock" class="w-2.5 h-2.5 text-slate-500" />
                Export CSV
              </button>
            </div>

            <div data-focus-region="orders" class="rounded-lg border border-white/8 overflow-hidden">
              <div
                class="grid grid-cols-[1fr_auto_auto] lg:grid-cols-[1fr_1fr_auto_auto] gap-2 px-2.5 py-1.5 bg-slate-800/50 text-[9px] font-bold uppercase tracking-wider text-slate-500"
              >
                {
                  /* The customer column is the one thing this table can lose without losing
                    the point, so it goes first: once a sketch is placed beside Refund the
                    actions column is wide, and the name matters less than the amount. */
                }
                <span>Order</span><span class="hidden lg:inline">Customer</span><span>Total</span><span></span>
              </div>
              {
                orders.map((o, i) => (
                  <div class="grid grid-cols-[1fr_auto_auto] lg:grid-cols-[1fr_1fr_auto_auto] gap-2 items-center px-2.5 py-1.5 border-t border-white/5">
                    <span class="text-[11px] font-mono text-slate-300">{o.id}</span>
                    <span class="hidden lg:inline text-[11px] text-slate-400 truncate">{o.customer}</span>
                    <span class="text-[11px] text-slate-300">{o.total}</span>
                    <div class="flex flex-col items-end" {...(i === 0 ? { 'data-focus-region': 'sketch' } : {})}>
                      <button
                        data-demo-control="refund"
                        class="demo-control rounded px-2 py-0.5 text-[10px] font-semibold text-rose-200 bg-rose-500/15 inline-flex items-center gap-1"
                      >
                        <Icon name="tabler:lock" class="refund-lock w-2.5 h-2.5 text-rose-200/70" />
                        Refund
                      </button>

                      {/* The sketch is placed against one occurrence, the way somebody
                          actually points at a screen. It grows the row rather than
                          covering anything, and turns real when the build lands. */}
                      {i === 0 && (
                        <span class="sketch-slot block overflow-hidden">
                          <button
                            data-demo-control="sketch"
                            class="sketch-btn whitespace-nowrap rounded px-2 py-0.5 text-[10px] font-semibold inline-flex items-center gap-1"
                          >
                            <Icon name="tabler:lock" class="sketch-lock w-2.5 h-2.5" />
                            Partial refund
                          </button>
                        </span>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- The panel -->
      <div
        class="w-full md:w-[19rem] flex-shrink-0 border-t-2 md:border-t-0 md:border-l-2 border-primary/45 bg-slate-900 flex flex-col"
      >
        <div class="md:hidden flex items-center gap-2 px-3 py-2 border-b border-white/8">
          <Image src={logoPng} alt="" width={13} height={17} style="transform:rotate(45deg)" />
          <span class="text-[10px] font-bold text-primary uppercase tracking-[0.18em]">DNA Overlay</span>
        </div>

        <div class="flex items-center gap-2 px-3 py-2 border-b border-white/8">
          <button data-demo-tab="inspect" class="panel-tab">Inspect</button>
          <button data-demo-tab="prototype" class="panel-tab">Prototype</button>
          <span class="text-[11px] text-slate-500">Settings</span>
        </div>

        <div data-pane="panel" class="relative flex-1 p-3 md:min-h-[19.5rem]">
          <span class="pane-scrim" aria-hidden="true"></span>

          <!-- Empty: the coverage line is the finding, not a statistic -->
          <div data-demo-panel="empty">
            <div class="rounded-lg border border-dashed border-white/12 px-3 py-6 text-center">
              <p class="text-xs text-slate-500">Click any control</p>
            </div>
            <div
              data-focus-region="coverage"
              class="mt-3 rounded-lg bg-primary/10 border border-primary/25 px-3 py-2.5"
            >
              <p class="text-xs text-slate-200 leading-relaxed">
                <span class="font-bold text-primary"><span data-coverage-count>2</span> of 3</span> controls are governed
                by something.
              </p>
            </div>
            <p class="mt-2 text-[10px] text-slate-600 leading-relaxed">
              Counted for this screen. It moves as you walk the product.
            </p>
          </div>

          <!-- Governed, routed elsewhere -->
          <div data-demo-panel="fulfillment" hidden>
            <p class="text-sm font-bold text-white">Fulfillment link</p>
            <dl class="mt-3 space-y-1.5">
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Address</dt>
                <dd class="text-[11px] font-mono text-slate-300 break-all">chrome.fulfillment-link</dd>
              </div>
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Operation</dt>
                <dd class="text-[11px] font-mono text-slate-300">order.fulfill</dd>
              </div>
            </dl>
            <div class="mt-3 pt-3 border-t border-white/8 space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">You may</span>
                <span
                  class="text-[9px] font-bold uppercase tracking-wider bg-primary/20 text-accent border border-primary/40 rounded px-1.5 py-0.5"
                  >Yes</span
                >
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Who may</span>
                <span class="text-[11px] text-slate-300">Fulfillment desk</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Used</span>
                <span class="text-[11px] text-slate-300">14 times · 3 people · 7d</span>
              </div>
            </div>
            <p class="mt-3 text-[10px] text-slate-500 leading-relaxed border-t border-white/8 pt-2.5">
              You hold the fulfillment desk, so you may open it. Tomas Reyes and June Alcott do too.
            </p>
          </div>

          <!-- Governed, restricted -->
          <div data-demo-panel="export" hidden>
            <p class="text-sm font-bold text-white">Export CSV</p>
            <dl class="mt-3 space-y-1.5">
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Address</dt>
                <dd class="text-[11px] font-mono text-slate-300 break-all">admin.orders.export</dd>
              </div>
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Operation</dt>
                <dd class="text-[11px] font-mono text-slate-300">customer.export</dd>
              </div>
            </dl>
            <div data-focus-region="answer" class="mt-3 pt-3 border-t border-white/8 space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">You may</span>
                <span
                  class="text-[9px] font-bold uppercase tracking-wider bg-rose-500/15 text-rose-300 border border-rose-400/30 rounded px-1.5 py-0.5"
                  >No</span
                >
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Who may</span>
                <span class="text-[11px] text-slate-300">Store manager</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Used</span>
                <span class="text-[11px] text-slate-300">2 times · 1 person · 7d</span>
              </div>
            </div>
            <p class="mt-3 text-[10px] text-slate-500 leading-relaxed border-t border-white/8 pt-2.5">
              Exporting customers is the store manager&rsquo;s. You do not hold that seat.
            </p>
          </div>

          <!-- Ungoverned: the finding that matters -->
          <div data-demo-panel="refund" hidden>
            <p class="text-sm font-bold text-white">Refund</p>
            <dl class="mt-3 space-y-1.5">
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Address</dt>
                <dd class="text-[11px] font-mono text-slate-300 break-all">admin.orders.refund</dd>
              </div>
            </dl>
            <div
              data-focus-region="gap"
              class="mt-3 flex items-start gap-2 rounded-lg border border-rose-400/25 bg-rose-500/8 px-2.5 py-2"
            >
              <Icon name="tabler:circle-dashed" class="w-3.5 h-3.5 flex-shrink-0 text-rose-300/80 mt-[3px]" />
              <p class="text-xs text-slate-200 leading-relaxed">
                Nothing governs this control — no access rule, no flag, no recorded use.
              </p>
            </div>
            <p class="mt-3 text-[10px] text-slate-500 leading-relaxed">
              Anyone who reaches this screen can refund any order, and nothing will record that they did.
            </p>

            <div class="mt-3 pt-3 border-t border-white/8">
              <p class="text-[9px] uppercase tracking-wider text-slate-500 mb-1.5">Restrict to</p>
              <button
                data-demo-govern
                class="w-full rounded-lg bg-primary/90 hover:bg-primary text-white text-[11px] font-semibold py-1.5 transition-colors duration-150"
              >
                Fulfillment desk
              </button>
              <p class="mt-1.5 text-[10px] text-slate-600">Written from here. No deploy.</p>
            </div>
          </div>

          <!-- ...and the same control a moment later, governed from inside the app -->
          <div data-demo-panel="refund-governed" hidden>
            <p class="text-sm font-bold text-white">Refund</p>
            <dl class="mt-3 space-y-1.5">
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Address</dt>
                <dd class="text-[11px] font-mono text-slate-300 break-all">admin.orders.refund</dd>
              </div>
              <div class="flex gap-2">
                <dt class="text-[9px] uppercase tracking-wider text-slate-500 w-16 flex-shrink-0 pt-0.5">Operation</dt>
                <dd class="text-[11px] font-mono text-slate-300">order.refund</dd>
              </div>
            </dl>

            <div class="mt-3 pt-3 border-t border-white/8 space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">You may</span>
                <span
                  class="text-[9px] font-bold uppercase tracking-wider bg-primary/20 text-accent border border-primary/40 rounded px-1.5 py-0.5"
                  >Yes</span
                >
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Who may</span>
                <span class="text-[11px] text-slate-300">Fulfillment desk</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Everyone else</span>
                <span
                  class="text-[9px] font-bold uppercase tracking-wider bg-rose-500/15 text-rose-300 border border-rose-400/30 rounded px-1.5 py-0.5"
                  >Blocked</span
                >
              </div>
            </div>

            <div class="mt-3 rounded-lg border border-primary/30 bg-primary/8 px-3 py-2.5">
              <p class="text-[11px] text-slate-200 leading-relaxed">
                Now governed. Every refund from here on is recorded, refusals included.
              </p>
            </div>

            <button
              data-demo-ungovern
              class="mt-3 text-[10px] text-slate-500 hover:text-slate-300 transition-colors duration-150 inline-flex items-center gap-1"
            >
              <Icon name="tabler:arrow-back-up" class="w-3 h-3" /> Undo
            </button>
          </div>

          <!-- ── Prototype ────────────────────────────────────────────── -->

          <!-- 1. The shelf: their components, grouped the way their product is -->
          <div data-demo-panel="shelf" hidden>
            <div class="flex items-baseline gap-2">
              <p class="text-[9px] uppercase tracking-wider text-slate-500">Components</p>
              <span class="ml-auto text-[10px] text-slate-500 truncate">Juniper Lane Storybook</span>
            </div>
            <p class="mt-1 text-[10px] text-slate-500">
              Placing against <span class="font-mono text-slate-400">admin.orders.refund</span>
            </p>

            <div data-focus-region="shelf">
              {
                shelf.map((group) => (
                  <div class="mt-3">
                    <p class="text-[9px] font-bold uppercase tracking-widest text-slate-600 mb-1.5">{group.group}</p>
                    <div class="grid grid-cols-2 gap-1.5">
                      {group.items.map((item) => (
                        <div
                          class:list={[
                            'rounded-lg border px-2 py-1.5',
                            item.picked
                              ? 'border-primary/70 bg-primary/12 shadow-[0_0_0_1px_rgba(13,148,136,0.25)]'
                              : 'border-white/10 bg-slate-800/40',
                          ]}
                        >
                          <p
                            class:list={[
                              'text-[10px] leading-tight truncate',
                              item.picked ? 'text-white font-semibold' : 'text-slate-300',
                            ]}
                          >
                            {item.name}
                          </p>
                          <p class="text-[9px] font-mono text-slate-600">{item.kind}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- 2. Placed: the address is the whole specification -->
          <div data-demo-panel="place" hidden>
            <p class="text-sm font-bold text-white">Quiet button</p>
            <p class="mt-0.5 text-[10px] text-slate-500">Juniper Lane Storybook · control</p>
