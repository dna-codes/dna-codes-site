              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[9px] uppercase tracking-wider text-slate-500">Who may</span>
                <span class="text-[11px] text-slate-300">Fulfillment desk</span>
              </div>
            </div>

            <div class="mt-3 rounded-lg border border-rose-400/25 bg-rose-500/8 px-3 py-2.5">
              <p class="text-[11px] text-slate-200 leading-relaxed">
                Refused — and written down. Somebody who could not say who they were tried to refund an order is the
                most interesting line a log can hold.
              </p>
            </div>

            <p class="mt-3 text-[10px] text-slate-500 leading-relaxed">
              The button on the left answers with the panel. Neither of them had to be told twice.
            </p>
          </div>

          <!-- 4. Three readers, one act -->
          <div data-demo-panel="record" hidden>
            <div data-focus-region="record">
              <p class="text-[9px] uppercase tracking-wider text-slate-500 mb-1.5">Audit</p>
              <div class="space-y-1">
                {
                  [
                    { who: 'June Alcott', when: '1m ago', outcome: 'Flag off', bad: false },
                    { who: 'Unidentified', when: '1m ago', outcome: 'Refused', bad: true },
                    { who: 'Priya Raman', when: '4m ago', outcome: 'Performed', bad: false },
                  ].map((row) => (
                    <div class="flex items-center gap-2 rounded bg-slate-800/50 px-2 py-1">
                      <span class="text-[11px] text-slate-300 truncate">{row.who}</span>
                      <span class="text-[10px] text-slate-600 ml-auto whitespace-nowrap">{row.when}</span>
                      <span
                        class:list={[
                          'text-[9px] font-bold uppercase tracking-wider rounded px-1.5 py-0.5 whitespace-nowrap',
                          row.bad
                            ? 'bg-rose-500/15 text-rose-300 border border-rose-400/30'
                            : 'bg-primary/15 text-accent border border-primary/30',
                        ]}
                      >
                        {row.outcome}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-white/8 grid grid-cols-2 gap-3">
              <div>
                <p class="text-[9px] uppercase tracking-wider text-slate-500">Usage · 7d</p>
                <p class="mt-0.5 text-lg font-extrabold text-white leading-none">128</p>
                <p class="text-[10px] text-slate-500 mt-0.5">times · 14 people</p>
              </div>
              <div>
                <p class="text-[9px] uppercase tracking-wider text-slate-500">Errors · 7d</p>
                <p class="mt-0.5 text-lg font-extrabold text-white leading-none">1</p>
                <p class="text-[10px] text-slate-500 mt-0.5">gateway timeout</p>
              </div>
            </div>

            <p class="mt-3 text-[10px] text-slate-500 leading-relaxed border-t border-white/8 pt-2.5">
              Nobody instrumented a button. Compliance, product and engineering are reading one act three ways.
            </p>
          </div>
        </div>

        <div class="px-3 py-2 border-t border-white/8 flex items-center gap-2">
          <span class="text-[10px] text-slate-500 border border-white/10 rounded px-1.5 py-0.5">Pick</span>
          <span class="text-[10px] text-slate-500 border border-white/10 rounded px-1.5 py-0.5">Hover</span>
          <span
            class="ml-auto text-[9px] font-bold uppercase tracking-wider text-amber-300/90 bg-amber-400/10 border border-amber-400/25 rounded px-1.5 py-0.5"
            >Demo mode</span
          >
        </div>
      </div>
    </div>
  </div>

  <!-- ── The narration ─────────────────────────────────────────────────────
       Kept below the frame rather than over it: a caption that covers the UI it
       is describing is worse than no caption. The rail is grouped by act, so the
       shape of the story — four readings, then four moves — is visible before you
       have watched any of it. -->
  <div class="mt-4 sm:mt-5">
    <div class="flex items-start gap-3 min-h-[4rem] sm:min-h-[3.25rem]">
      <span class="act-chip act-inspect">Inspect</span>
      <span class="act-chip act-govern">Govern</span>

      <div class="flex-1 min-w-0">
        {
          steps.map((s, i) => (
            <p data-caption={String(i)} hidden={i !== 0} class="text-sm text-slate-300 leading-relaxed">
              <strong class="text-white font-semibold">{s.lead}</strong>{' '}
              <span class="[&_code]:text-accent [&_code]:text-[0.9em]" set:html={s.body} />
            </p>
          ))
        }
        <p data-caption="free" hidden class="text-sm text-slate-300 leading-relaxed">
          <strong class="text-white font-semibold">Yours to poke at.</strong> Click any control and the panel answers for
          it — the story picks back up whenever you press play.
        </p>
      </div>
    </div>

    <div class="mt-3 flex items-center gap-3 sm:gap-4">
      {
        acts.map((act) => (
          <div
            class="flex flex-1 items-center gap-1.5"
            role="group"
            aria-label={act === 'inspect' ? 'Inspect' : 'Govern'}
          >
            {steps.map((s, i) =>
              s.act !== act ? null : (
                <button
                  data-step={String(i)}
                  data-dur={String(s.ms)}
                  data-step-act={s.act}
                  data-step-panel={s.panel}
                  data-step-control={s.control ?? ''}
                  data-step-governed={String(!!s.governed)}
                  data-step-flag={s.flag ?? 'on'}
                  data-step-viewer={s.viewer ?? VIEWER}
                  data-step-seat={s.seat ?? ''}
                  data-step-pane={s.pane}
                  data-step-region={s.region ?? ''}
                  class="rail flex-1 py-2 cursor-pointer"
                  title={s.lead}
                  aria-label={`Step ${i + 1}: ${s.lead}`}
                >
                  <span class="rail-track block h-[3px] rounded-full bg-white/12 overflow-hidden">
                    <span class="rail-fill block h-full w-full origin-left" />
                  </span>
                </button>
              )
            )}
          </div>
        ))
      }

      <button
        data-demo-play
        class="flex-shrink-0 text-[11px] text-slate-500 hover:text-slate-300 transition-colors duration-150 inline-flex items-center gap-1"
      >
        <Icon name="tabler:player-pause-filled" class="when-playing w-3.5 h-3.5" />
        <Icon name="tabler:player-play-filled" class="when-paused w-3.5 h-3.5" />
        <span class="when-playing">Pause</span>
        <span class="when-paused">Play</span>
      </button>
    </div>
  </div>
</div>

<style>
  /* ── Focus ─────────────────────────────────────────────────────────────
     A scrim over the half that is not the subject, and a ring on the block the
     caption names. The scrim is a layer rather than opacity on the pane, so the
     selected control can sit *above* it at full strength — dimming the app while
     one button stays lit is the whole "this control, answered here" idea. */
  /* A panel arriving instantly reads as a jump cut, and at this pace the eye has time to
     notice the seam. Going from display:none to shown restarts this on its own. */
  [data-demo-panel]:not([hidden]) {
    animation: panel-in 0.3s ease both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }

  .pane-scrim {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: rgb(2 6 23 / 62%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  [data-pane-focus='panel'] [data-pane='app'] .pane-scrim,
  [data-pane-focus='app'] [data-pane='panel'] .pane-scrim {
    opacity: 1;
  }

  /* The ring takes the colour of the act, so the rail, the chip and the thing being
     pointed at always agree about which half of the story you are in. */
  [data-overlay-demo] {
    --focus-ring: rgb(45 212 191 / 55%);
  }
  [data-overlay-demo][data-tab='govern'] {
    --focus-ring: rgb(167 139 250 / 65%);
  }
  [data-focus-region] {
    outline: 1.5px solid transparent;
    outline-offset: 5px;
    border-radius: 7px;
    transition: outline-color 0.35s ease;
  }
  [data-region='coverage'] [data-focus-region='coverage'],
  [data-region='answer'] [data-focus-region='answer'],
  [data-region='gap'] [data-focus-region='gap'],
  [data-region='orders'] [data-focus-region='orders'],
  [data-region='chain'] [data-focus-region='chain'],
  [data-region='verdict'] [data-focus-region='verdict'],
  [data-region='record'] [data-focus-region='record'] {
    outline-color: var(--focus-ring);
  }

  .demo-control {
    position: relative;
    cursor: pointer;
    outline: 1px dashed rgb(148 163 184 / 35%);
    outline-offset: 1px;
    transition:
      outline-color 0.15s ease,
      background-color 0.15s ease;
  }
  /* Above the scrim: the control under discussion is never the thing being dimmed. */
  .demo-control[data-selected='true'],
  .sketch-btn[data-selected='true'] {
    z-index: 6;
  }
  .demo-control:hover {
    outline-color: rgb(45 212 191 / 70%);
  }
  .demo-control[data-selected='true'] {
    outline: 2px solid rgb(45 212 191);
    outline-offset: 1px;
  }

  /* The padlock only exists once a rule does. */
  .refund-lock {
    display: none;
  }
  [data-refund-governed='true'] .refund-lock {
    display: inline-block;
  }

  /* Panel tabs follow the story rather than decorating it. */
  .panel-tab {
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
    font-size: 11px;
    color: rgb(100 116 139);
    transition: color 0.15s ease;
  }
  .panel-tab:hover {
    color: rgb(203 213 225);
  }
  [data-tab='inspect'] .panel-tab[data-demo-tab='inspect'],
  [data-tab='govern'] .panel-tab[data-demo-tab='govern'] {
    color: white;
    font-weight: 600;
    border-color: rgb(13 148 136 / 60%);
  }

  /* Two hints for one line of space. */
  .when-govern,
  [data-tab='govern'] .when-inspect {
    display: none;
  }
  [data-tab='govern'] .when-govern {
    display: inline;
  }

  /* Flag off: the control is gone, not disabled. A dash holds the column so the table
     does not reflow, and it is not something anybody can press. The two swap rather than
     one covering the other, so at no point are both on screen. */
  .flag-off-dash {
    display: none;
  }
  [data-flag='off'] .refund-btn {
    display: none;
  }
  [data-flag='off'] .flag-off-dash {
    display: inline-block;
  }

  /* No seat: the button answers the way the panel does. Dimmed and struck through with a
     refusal-coloured outline rather than removed — being told no is the whole difference
     between this state and the one above it. */
  [data-seat='none'] .refund-btn {
    opacity: 0.5;
    background: transparent;
    outline: 1px dashed rgb(244 63 94 / 55%);
    cursor: not-allowed;
  }

  /* Narration */
  .act-chip {
    flex-shrink: 0;
    border-radius: 9999px;
    border-width: 1px;
    padding: 0.125rem 0.625rem;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.125rem;
  }
  .act-inspect {
    color: rgb(45 212 191);
    border-color: rgb(13 148 136 / 45%);
    background: rgb(13 148 136 / 12%);
  }
  .act-govern {
    color: rgb(196 181 253);
    border-color: rgb(167 139 250 / 45%);
    background: rgb(167 139 250 / 12%);
  }
  [data-tab='inspect'] .act-govern,
  [data-tab='govern'] .act-inspect {
    display: none;
  }

  .rail-fill {
    transform: scaleX(0);
    background: rgb(45 212 191);
  }
  [data-step-act='govern'] .rail-fill {
    background: rgb(167 139 250);
  }
  .rail:hover .rail-track {
    background: rgb(255 255 255 / 25%);
  }
  /* A full bar means "done" everywhere except here, where it can also mean "held". The
     glow is what separates the two, so it has to be on the current step either way. */
  .rail[data-current] .rail-fill {
    box-shadow: 0 0 9px var(--focus-ring);
  }
  .rail[data-current] .rail-track {
    background: rgb(255 255 255 / 22%);
  }

  .when-paused,
  [data-paused='true'] .when-playing {
    display: none;
  }
  [data-paused='true'] .when-paused {
    display: inline-block;
  }

  @media (prefers-reduced-motion: reduce) {
    .refund-btn,
    [data-demo-panel]:not([hidden]) {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-overlay-demo]').forEach((demo) => {
    const rail = Array.from(demo.querySelectorAll<HTMLElement>('[data-step]'));
    const captions = Array.from(demo.querySelectorAll<HTMLElement>('[data-caption]'));
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-panel]'));
    const controls = Array.from(demo.querySelectorAll<HTMLElement>('[data-demo-control]'));
    const coverage = demo.querySelector<HTMLElement>('[data-coverage-count]');
    const viewerName = demo.querySelector<HTMLElement>('[data-viewer-name]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!rail.length) return;

    // The default identity, read off step one rather than restated here: the frontmatter
    // const is not in scope in a client module, and two copies of the same name is exactly
    // the sort of thing that goes stale silently.
    const defaultViewer = rail[0].dataset.stepViewer ?? '';

    // A step is found by what it does, not by an index the markup and the script would
    // both have to agree on: every jump below names a panel.
    const stepOf = (panel: string) => rail.findIndex((r) => r.dataset.stepPanel === panel);

    let current = 0;
    let elapsed = 0;
    let paused = reduced; // reduced motion gets the story, on their own thumb
    let visible = true;
    let frame = 0;
    let last = 0;

    const setPaused = (next: boolean) => {
      paused = next;
      demo.setAttribute('data-paused', String(next));
    };

    const fill = (i: number, p: number) => {
      const bar = rail[i].querySelector<HTMLElement>('.rail-fill');
      if (bar) bar.style.transform = `scaleX(${p})`;
    };

    // Everything the frame shows is a pure function of the step. Nothing accumulates, so
    // jumping backwards from the rail lands in exactly the state that step describes.
    //
    // `held` is a step somebody chose rather than one that came up in turn. Its bar reads
    // full: a picked step is being given its whole duration, and a bar creeping from zero
    // under a paused story would suggest a clock that is not running. Pressing play hands
    // it back to the loop, which refills it from zero over the step's own time.
    const render = (i: number, caption: string, held = false) => {
      const s = rail[i].dataset;
      const governed = s.stepGoverned === 'true';

      demo.setAttribute('data-tab', s.stepAct!);
      demo.setAttribute('data-flag', s.stepFlag!);
      demo.setAttribute('data-seat', s.stepSeat!);
      demo.setAttribute('data-refund-governed', String(governed));
      demo.setAttribute('data-pane-focus', s.stepPane!);
      demo.setAttribute('data-region', s.stepRegion!);
      if (coverage) coverage.textContent = governed ? '3' : '2';
      if (viewerName) viewerName.textContent = s.stepViewer!;

      panels.forEach((p) => (p.hidden = p.dataset.demoPanel !== s.stepPanel));
      controls.forEach((c) => c.setAttribute('data-selected', String(c.dataset.demoControl === s.stepControl)));
      captions.forEach((c) => (c.hidden = c.dataset.caption !== caption));
      rail.forEach((r, k) => {
        fill(k, k < i || (held && k === i) ? 1 : 0);
        // Once earlier bars can also be full, "where am I" needs saying separately.
        r.toggleAttribute('data-current', k === i);
        if (k === i) r.setAttribute('aria-current', 'step');
        else r.removeAttribute('aria-current');
      });
    };

    const go = (i: number, held = false) => {
      current = ((i % rail.length) + rail.length) % rail.length;
      elapsed = 0;
      render(current, String(current), held);
    };

    // Taking over: the panel answers for whatever was clicked, and the rail steps back to
    // whichever step that reading belongs to so play resumes somewhere coherent.
    const takeOver = (panel: string) => {
      setPaused(true);
      const i = stepOf(panel);
      if (i >= 0) return go(i, true);

      // Off-story readings — Fulfillment — keep the current governance rather than
      // inventing one, so nothing the story established is quietly undone. The spotlight
      // comes off entirely: nobody is being walked through anything now, and the panel goes
      // back to answering as you rather than as whoever the last step borrowed.
      demo.setAttribute('data-pane-focus', 'both');
      demo.setAttribute('data-region', '');
      demo.setAttribute('data-seat', '');
      demo.setAttribute('data-flag', 'on');
      if (viewerName) viewerName.textContent = defaultViewer;
      panels.forEach((p) => (p.hidden = p.dataset.demoPanel !== panel));
      controls.forEach((c) => c.setAttribute('data-selected', String(c.dataset.demoControl === panel)));
      captions.forEach((c) => (c.hidden = c.dataset.caption !== 'free'));
      rail.forEach((_, k) => fill(k, 0));
    };

    const loop = (t: number) => {
      const dt = Math.min(t - last, 100); // a backgrounded tab must not skip three steps
      last = t;
      if (!paused && visible) {
        elapsed += dt;
        const dur = Number(rail[current].dataset.dur) || 4000;
        fill(current, Math.min(1, elapsed / dur));
        if (elapsed >= dur) go(current + 1);
      }
      frame = requestAnimationFrame(loop);
    };

    rail.forEach((r, i) =>
      r.addEventListener('click', () => {
        setPaused(true);
        go(i, true);
      })
    );

    controls.forEach((c) =>
      c.addEventListener('click', () => {
        const control = c.dataset.demoControl!;
        if (control === 'refund')
          return takeOver(demo.dataset.refundGoverned === 'true' ? 'refund-governed' : 'refund');
        takeOver(control);
      })
    );

    demo.querySelectorAll<HTMLElement>('[data-demo-tab]').forEach((tab) =>
      tab.addEventListener('click', () => {
        setPaused(true);
        go(stepOf(tab.dataset.demoTab === 'govern' ? 'flag' : 'empty'), true);
      })
    );

    demo.querySelector<HTMLElement>('[data-demo-govern]')?.addEventListener('click', () => takeOver('refund-governed'));
    demo.querySelector<HTMLElement>('[data-demo-ungovern]')?.addEventListener('click', () => takeOver('refund'));
    // The flag toggle is the one control in the panel worth making real: flipping it is the
    // step, so a reader who reaches for it gets the step rather than a dead switch.
    demo.querySelector<HTMLElement>('[data-demo-flag-off]')?.addEventListener('click', () => takeOver('flag-off'));
    demo.querySelector<HTMLElement>('[data-demo-flag-on]')?.addEventListener('click', () => takeOver('flag'));

    demo.querySelector<HTMLElement>('[data-demo-play]')?.addEventListener('click', () => setPaused(!paused));

    demo.querySelector<HTMLElement>('[data-demo-restart]')?.addEventListener('click', () => {
      setPaused(reduced);
      go(0);
    });

    // Nothing advances while nobody is looking: a story that has already played itself out
    // above the fold is worse than one that has not started.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          last = performance.now();
        },
        { threshold: 0.35 }
      ).observe(demo);
    }
    document.addEventListener('visibilitychange', () => {
      last = performance.now();
    });

    setPaused(paused);
    go(0);
    last = performance.now();
    frame = requestAnimationFrame(loop);
    window.addEventListener('pagehide', () => cancelAnimationFrame(frame));
  });
</script>
