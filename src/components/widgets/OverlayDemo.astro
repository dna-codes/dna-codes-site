              s.act !== act ? null : (
                <button
                  data-step={String(i)}
                  data-dur={String(s.ms)}
                  data-step-act={s.act}
                  data-step-panel={s.panel}
                  data-step-control={s.control ?? ''}
                  data-step-governed={String(!!s.governed)}
