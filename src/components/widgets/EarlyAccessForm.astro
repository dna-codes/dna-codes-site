---
import { Icon } from 'astro-icon/components';

// TODO(launch): paste the endpoint here and the form starts working. Nothing else
// needs to change — submission, the success state and the honeypot are already wired.
//
// The site is `output: 'static'` on GitHub Pages, so there is no server to POST to:
// it has to be a third-party endpoint. Formspree (https://formspree.io/f/xxxxxxxx)
// is the recommendation; Basin and Web3Forms take the same shape.
//
// Whatever it becomes must accept the five fields below. `governedBy` is the
// qualification field: an answer naming a flag vendor and an authz vendor is a
// priced comparison in one line — so it must not be dropped by an email tool that
// only understands name and address.
//
// Until it is set, the form refuses loudly rather than appearing to succeed into a
// void: somebody who believes they are on a list they are not on is the worst
// outcome available here.
const ACTION_URL = '';

interface Field {
  name: string;
  label: string;
  type: 'text' | 'email';
  autocomplete?: string;
  placeholder?: string;
  required: boolean;
  /** Sits in one of two columns rather than spanning the row. */
  half: boolean;
}

const fields: Field[] = [
  { name: 'name', label: 'Name', type: 'text', autocomplete: 'name', required: true, half: true },
  { name: 'email', label: 'Work email', type: 'email', autocomplete: 'email', required: true, half: true },
  { name: 'company', label: 'Company', type: 'text', autocomplete: 'organization', required: true, half: false },
  {
    name: 'stack',
    label: 'What is your application built with?',
    type: 'text',
    placeholder: 'React, Vue, Rails + Hotwire…',
    required: true,
    half: false,
  },
];
---

<div id="early-access" class="scroll-mt-24">
  <form
    data-early-access
    class="max-w-xl mx-auto text-left"
    {...ACTION_URL ? { action: ACTION_URL, method: 'POST' } : {}}
  >
    <!-- Honeypot. Bots fill every field they find; people never see this one.
         `_gotcha` is the name Formspree and Basin both recognise. -->
    <div aria-hidden="true" class="sr-only">
      <label>
        Leave this empty
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        fields.map((f) => (
          <div class:list={[f.half ? 'sm:col-span-1' : 'sm:col-span-2']}>
            <label for={`ea-${f.name}`} class="block text-xs font-semibold text-slate-300 mb-1.5">
              {f.label}
            </label>
            <input
              id={`ea-${f.name}`}
              name={f.name}
              type={f.type}
              required={f.required}
              autocomplete={f.autocomplete}
              placeholder={f.placeholder}
              class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800/80 border border-slate-600 text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
            />
          </div>
        ))
      }

      <div class="sm:col-span-2">
        <label for="ea-governedBy" class="block text-xs font-semibold text-slate-300 mb-1.5">
          What governs your controls today?
        </label>
        <textarea
          id="ea-governedBy"
          name="governedBy"
          rows="3"
          placeholder="Flags in LaunchDarkly, roles in our own middleware, analytics in Amplitude, audit… nowhere, honestly."
          class="w-full px-3.5 py-2.5 rounded-lg bg-slate-800/80 border border-slate-600 text-slate-100 placeholder-slate-500 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary resize-y"
        ></textarea>
        <p class="mt-1.5 text-xs text-slate-500">
          The most useful box on this page. Rough is fine — “nowhere, honestly” is a real answer and a common one.
        </p>
      </div>
    </div>

    <button
      type="submit"
      data-early-access-submit
      class="btn-primary w-full mt-5 py-3 text-sm font-semibold rounded-lg"
    >
      Get early access
    </button>

    <p data-early-access-error class="mt-3 text-sm text-amber-300 text-center" hidden></p>

    <p class="mt-4 text-xs text-slate-500 text-center leading-relaxed">
      We reply by hand, usually within a day. No sequence, no drip, no spam.
    </p>
  </form>

  <div data-early-access-success class="max-w-xl mx-auto text-center py-8" hidden>
    <div
      class="w-12 h-12 rounded-full bg-primary/15 border border-primary/40 flex items-center justify-center mx-auto mb-4"
    >
      <Icon name="tabler:check" class="w-6 h-6 text-primary" />
    </div>
    <p class="text-lg font-bold text-white">Got it — thank you.</p>
    <p class="mt-2 text-sm text-muted leading-relaxed">
      We read every one of these by hand. Expect a reply from a person, usually within a day.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-early-access]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-early-access-error]');
    const submit = form.querySelector<HTMLButtonElement>('[data-early-access-submit]');
    const success = form.parentElement?.querySelector<HTMLElement>('[data-early-access-success]');

    const fail = (message: string) => {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      const action = form.getAttribute('action');

      // An unconfigured form that silently "succeeds" is worse than one that refuses:
      // the visitor believes they are on a list they are not on.
      if (!action) {
        event.preventDefault();
        fail('This form is not connected yet. Email tim@upgradesolutions.io and we will set you up.');
        return;
      }

      // Submit in place. A native POST navigates to the form provider's own page,
      // which loses the visitor at the exact moment they committed.
      event.preventDefault();
      if (error) error.hidden = true;
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const response = await fetch(action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error(String(response.status));

        form.hidden = true;
        if (success) success.hidden = false;
      } catch {
        fail('That did not go through. Try again, or email tim@upgradesolutions.io.');
        if (submit) {
          submit.disabled = false;
          submit.textContent = 'Get early access';
        }
      }
    });
  });
</script>
