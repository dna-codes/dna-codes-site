---
import { twMerge } from 'tailwind-merge';

// Actor → Action → Resource, plus the condition under which the action applies.
// Inputs and outputs stay off this figure: they vary by operation, the triple does not.

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rows = [
  {
    industry: 'Lending',
    actor: 'Underwriter',
    kind: 'Person',
    action: 'Approve',
    resource: 'LoanApplication',
    condition: 'Credit policy passes and collateral is valued',
  },
  {
    industry: 'Care',
    actor: 'Physician',
    kind: 'Person',
    action: 'Discharge',
    resource: 'Encounter',
    condition: 'Required orders have resulted',
  },
  {
    industry: 'Logistics',
    actor: 'Dispatcher',
    kind: 'Person',
    action: 'Dispatch',
    resource: 'Shipment',
    condition: 'A carrier is assigned and the window is open',
  },
  {
    industry: 'Billing',
    actor: 'Billing system',
    kind: 'System',
    action: 'Issue',
    resource: 'Invoice',
    condition: 'The order is fulfilled',
  },
  {
    industry: 'Collections',
    actor: 'Collections agent',
    kind: 'Agent',
    action: 'Escalate',
    resource: 'Invoice',
    condition: 'Past due, and no payment recorded',
  },
  {
    industry: 'Compliance',
    actor: 'Records officer',
    kind: 'Person',
    action: 'Archive',
    resource: 'SignedContract',
    condition: 'The file is fully executed',
  },
];
---

<figure class={twMerge('not-prose my-10', className)}>
  <div
    class="overflow-hidden rounded-2xl border-2 border-primary bg-slate-900/90 shadow-[0_0_48px_rgba(13,148,136,0.25)]"
  >
    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/8 p-3 sm:px-4">
      <span class="text-xs font-bold uppercase tracking-widest text-primary">Actor → Action → Resource</span>
      <span class="text-[11px] uppercase tracking-wider text-slate-500">When the action applies</span>
    </div>

    <div class="hidden md:block overflow-x-auto">
      <table class="w-full min-w-[44rem] border-collapse text-left">
        <thead>
          <tr class="border-b border-white/8 text-[11px] font-bold uppercase tracking-wider text-slate-500">
            <th class="px-4 py-2.5 font-bold" scope="col">Industry</th>
            <th class="px-3 py-2.5 font-bold" scope="col">Actor</th>
            <th class="px-3 py-2.5 font-bold" scope="col">Action</th>
            <th class="px-3 py-2.5 font-bold" scope="col">Resource</th>
            <th class="px-4 py-2.5 font-bold" scope="col">Condition</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-white/5 last:border-0">
                <td class="px-4 py-3 text-sm text-slate-300">{row.industry}</td>
                <td class="px-3 py-3">
                  <span class="block text-sm text-slate-100">{row.actor}</span>
                  <span class="mt-0.5 block text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    {row.kind}
                  </span>
                </td>
                <td class="px-3 py-3 font-mono text-sm text-primary">{row.action}</td>
                <td class="px-3 py-3 font-mono text-sm text-slate-200">{row.resource}</td>
                <td class="px-4 py-3 text-sm leading-snug text-slate-400">{row.condition}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <ul class="divide-y divide-white/8 md:hidden">
      {
        rows.map((row) => (
          <li class="px-4 py-3.5">
            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500">
              {row.industry}
              <span class="text-slate-600"> · </span>
              {row.kind}
            </p>
            <p class="mt-1.5 text-sm leading-relaxed">
              <span class="text-slate-100">{row.actor}</span>
              <span class="text-slate-600"> → </span>
              <span class="font-mono text-primary">{row.action}</span>
              <span class="text-slate-600"> → </span>
              <span class="font-mono text-slate-200">{row.resource}</span>
            </p>
            <p class="mt-1.5 text-sm leading-snug text-slate-400">{row.condition}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <figcaption class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-400">
    The same triple in six industries. A person, a system, and an agent can all be the actor. A signed contract is a
    file, and it is still a resource. The last column is the condition: the state the resource is in when this action
    applies.
  </figcaption>
</figure>
