---
import { Icon } from 'astro-icon/components';
import { CARD_TIERS, PRICING_CTA } from '~/data/pricing';

interface Props {
  /** Shown on /overlay, hidden on /pricing where the full matrix follows immediately. */
  compareHref?: string;
}

const { compareHref } = Astro.props;
---

<div class="grid gap-5 sm:grid-cols-3 max-w-5xl mx-auto">
  {
    CARD_TIERS.map((tier) => (
      <div
        class:list={[
          'relative flex flex-col rounded-2xl border p-6 bg-slate-900/70 backdrop-blur',
          tier.featured
            ? 'border-primary shadow-[0_0_40px_rgba(13,148,136,0.28)]'
            : 'border-white/10 hover:border-white/20 transition-colors duration-150',
        ]}
      >
        {tier.featured && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white">
            Most teams
          </span>
        )}

        <p class="text-xs font-bold uppercase tracking-widest text-primary">{tier.name}</p>

        <div class="mt-3 flex items-baseline gap-1.5">
          <span class="text-4xl font-extrabold text-white">{tier.priceLabel}</span>
          <span class="text-sm text-slate-500">/mo</span>
        </div>

        <p class="mt-3 text-sm text-slate-400 leading-relaxed min-h-[3.5rem]">{tier.audience}</p>

        <ul class="mt-5 space-y-2.5 flex-1">
          {tier.highlights.map((h) => (
            <li class="flex items-start gap-2.5 text-sm text-slate-300 leading-snug">
              <Icon name="tabler:check" class="w-4 h-4 text-primary flex-shrink-0 mt-0.5" />
              <span>{h}</span>
            </li>
          ))}
        </ul>

        <a
          href={PRICING_CTA.href}
          class:list={[
            'mt-6 inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold transition-colors duration-150',
            tier.featured
              ? 'bg-primary text-white hover:bg-secondary'
              : 'border border-slate-600 text-slate-200 hover:border-slate-400 hover:bg-slate-800',
          ]}
        >
          {PRICING_CTA.text}
        </a>
      </div>
    ))
  }
</div>

<p class="mt-6 text-center text-sm text-slate-500">
  Billed annually at two months free. Every plan includes the console, the Playground, the docs and the MCP tools.
  {
    compareHref && (
      <>
        {' '}
        <a href={compareHref} class="text-primary hover:text-accent underline underline-offset-4">
          See the full comparison
        </a>
      </>
    )
  }
</p>
