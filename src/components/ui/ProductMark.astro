---
import { Icon } from 'astro-icon/components';

// The product logo: a glyph in a branded tile. A mark rather than a bare icon, because
// the two products need to read as things with names — the tile is what stops a 16px
// glyph in a menu from looking like decoration. Icons come from ~/data/products so the
// same product wears the same mark in the nav, on the homepage and on the waitlist form.
export interface Props {
  icon: string;
  /** `sm` for menus and lists, `md` for cards. */
  size?: 'sm' | 'md';
  class?: string;
}

const { icon, size = 'md', class: className = '' } = Astro.props;

const box = size === 'sm' ? 'w-7 h-7 rounded-md' : 'w-9 h-9 rounded-lg';
const glyph = size === 'sm' ? 'w-4 h-4' : 'w-5 h-5';
---

<span
  class:list={[
    'inline-flex items-center justify-center flex-shrink-0 border border-primary/40 bg-primary/15 text-primary',
    box,
    className,
  ]}
  aria-hidden="true"
>
  <Icon name={icon} class={glyph} />
</span>
