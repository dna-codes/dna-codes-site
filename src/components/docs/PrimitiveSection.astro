---
import FieldsTable from '~/components/docs/FieldsTable.astro';
import StabilityPill from '~/components/docs/StabilityPill.astro';
import { extractFields, splitDescription, slugify, firstExample, getStability } from '~/utils/schema-doc';

export interface RelatedLink {
  label: string;
  href: string;
}

export interface Props {
  schema: {
    $id?: string;
    title?: string;
    description?: string;
    required?: string[];
    properties?: Record<string, unknown>;
    examples?: unknown[];
    stability?: unknown;
    $defs?: Record<string, unknown>;
    oneOf?: unknown[];
  };
  related?: RelatedLink[];
  /** Corpus excerpt. Pass null to force the example block off. Omit to use schema.examples. */
  example?: string | null;
  exampleSource?: string | null;
}

const { schema, related = [], example: exampleProp, exampleSource = null } = Astro.props;

const title = schema.title ?? 'Untitled';
const id = slugify(title);
const paragraphs = splitDescription(schema.description);
const fields = extractFields(schema as Parameters<typeof extractFields>[0]);
const example = exampleProp === undefined ? firstExample(schema as Parameters<typeof firstExample>[0]) : exampleProp;
const stability = getStability(schema);
---

<section id={id} class="scroll-mt-24">
  <h3 class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <a href={`#${id}`} class="no-underline hover:underline">{title}</a>
    <StabilityPill level={stability} />
  </h3>

  {paragraphs.map((p) => <p>{p}</p>)}

  {
    fields.length > 0 && (
      <h4 class="mt-6 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-400">Fields</h4>
    )
  }
  <FieldsTable fields={fields} />

  {
    example && (
      <>
        <h4 class="mt-6 mb-2 text-sm font-semibold uppercase tracking-wide text-gray-600 dark:text-slate-400">
          Example
        </h4>
        {exampleSource && (
          <p class="text-xs text-gray-500 dark:text-slate-500">
            From <code>{exampleSource}</code>
          </p>
        )}
        <pre>
          <code class="language-json">{example}</code>
        </pre>
      </>
    )
  }

  {
    related.length > 0 && (
      <p class="mt-6 text-sm text-gray-600 dark:text-slate-400">
        <span class="font-semibold">Related:</span>{' '}
        {related.map((r, i) => (
          <>
            {i > 0 && <span class="text-gray-400"> · </span>}
            <a href={r.href} class="text-primary hover:underline">
              {r.label}
            </a>
          </>
        ))}
      </p>
    )
  }
</section>
