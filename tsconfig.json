{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "~schemas/*": ["node_modules/@dna-codes/dna-schemas/*"],
      "~lenses/*": ["node_modules/@dna-codes/dna-core/lenses/*"],
      "~core-schemas/*": ["vendor/core-schemas/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist/"]
}
