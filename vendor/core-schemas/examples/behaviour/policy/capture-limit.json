{
  "id": "capture-limit",
  "description": "A capture above 10000 is routed to an agent for review rather than performed.",
  "actions": [
    "capture"
  ],
  "when": {
    "subject": "input",
    "path": "amount",
    "op": "gt",
    "value": 10000
  },
  "effect": {
    "effect": "route",
    "performer": "agent"
  }
}
