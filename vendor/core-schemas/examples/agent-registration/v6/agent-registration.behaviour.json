  ],
  "workflows": [
    {
      "id": "registration",
      "name": "Registration",
      "description": "From a challenge to production or expired, with suspension after production.",
      "initial": "challenging",
      "states": [
        {
          "id": "challenging",
          "name": "Challenge issued",
          "operations": [
            "host-issues-challenge"
          ],
          "transitions": [
            {
              "on": "host-issues-challenge",
              "to": "registering"
            }
          ]
        },
        {
          "id": "registering",
          "name": "Registering",
          "description": "A refused solution sends the agent back for a new challenge.",
          "operations": [
            "agent-registers"
          ],
          "transitions": [
            {
              "on": "agent-registers",
              "to": "sandbox"
            },
            {
              "on": "agent-registers",
              "status": "failed",
              "to": "challenging"
            }
          ]
        },
        {
          "id": "sandbox",
          "name": "Sandbox",
          "description": "The agent authors until its person claims or the sandbox expires.",
          "operations": [
            "agent-describe",
            "agent-validate",
            "agent-apply",
            "agent-get",
            "agent-list",
            "agent-diff",
            "agent-renews",
            "person-claims",
            "host-expires",
            "agent-forum-list",
            "agent-forum-post",
            "agent-forum-vote"
          ],
          "transitions": [
            {
              "on": "agent-describe",
              "to": "sandbox"
            },
            {
              "on": "agent-validate",
              "to": "sandbox"
            },
            {
              "on": "agent-apply",
              "to": "sandbox"
            },
            {
              "on": "agent-get",
              "to": "sandbox"
            },
            {
              "on": "agent-list",
              "to": "sandbox"
            },
            {
              "on": "agent-diff",
              "to": "sandbox"
            },
            {
              "on": "agent-renews",
              "to": "sandbox"
            },
            {
              "on": "person-claims",
              "to": "production"
            },
            {
              "on": "host-expires",
              "to": "expired"
            },
            {
              "on": "agent-forum-list",
              "to": "sandbox"
            },
            {
              "on": "agent-forum-post",
              "to": "sandbox"
            },
            {
              "on": "agent-forum-vote",
              "to": "sandbox"
            }
          ]
        },
        {
          "id": "production",
          "name": "Production",
          "description": "Claimed. The agent and its person author until a DNA admin suspends it.",
          "operations": [
            "agent-describe",
            "agent-validate",
            "agent-apply",
            "agent-get",
            "agent-list",
            "agent-diff",
            "person-describe",
            "person-validate",
            "person-apply",
            "person-get",
            "person-list",
            "person-diff",
            "person-sets-egress",
            "person-revokes",
            "admin-suspends",
            "agent-forum-list",
            "agent-forum-post",
            "agent-forum-vote",
            "person-forum-list",
            "person-forum-post",
            "person-forum-vote"
          ],
          "transitions": [
            {
              "on": "person-revokes",
              "to": "production"
            },
            {
              "on": "admin-suspends",
              "to": "suspended"
            }
          ]
        },
        {
          "id": "suspended",
          "name": "Suspended",
          "operations": [
            "admin-reinstates",
            "admin-retires"
          ],
          "transitions": [
            {
              "on": "admin-reinstates",
              "to": "production"
            },
            {
              "on": "admin-retires",
              "to": "expired"
            }
          ]
        },
        {
          "id": "expired",
          "name": "Expired",
          "final": true
        }
      ]
    }
  ],
  "policies": [
    {
      "id": "per-client-registrations",
      "description": "A client registers at most 30 times an hour. The evaluator supplies the count.",
      "actions": [
        "register"
      ],
      "when": {
        "subject": "context",
        "path": "registrationsFromClientThisHour",
        "op": "gte",
        "value": 30
      },
      "effect": {
        "effect": "deny"
      }
    },
    {
      "id": "per-network-registrations",
      "description": "A source network registers at most 10 times an hour.",
      "actions": [
        "register"
      ],
      "when": {
        "subject": "context",
        "path": "registrationsFromNetworkThisHour",
        "op": "gte",
        "value": 10
      },
      "effect": {
        "effect": "deny"
      }
    },
    {
      "id": "sandbox-daily-cap",
      "description": "An unclaimed sandbox performs at most 100 governed acts a UTC day.",
      "actions": [
        "apply"
      ],
      "when": {
        "allOf": [
          {
            "subject": "context",
            "path": "environment",
            "op": "eq",
            "value": "sandbox"
          },
          {
            "subject": "context",
            "path": "governedActsToday",
            "op": "gte",
            "value": 100
          }
        ]
      },
      "effect": {
        "effect": "deny"
      }
    },
    {
      "id": "inactive-refused",
      "description": "An expired or suspended organization's credentials resolve to nobody.",
      "actions": [
        "describe",
        "validate",
        "apply",
        "get",
        "list",
        "diff",
        "renew-credential",
        "revoke-credential",
        "set-egress-allowlist",
        "forum-list",
        "forum-post",
        "forum-vote"
      ],
      "when": {
        "subject": "context",
        "path": "registrationStatus",
        "op": "in",
        "value": [
          "expired",
          "suspended"
        ]
      },
      "effect": {
        "effect": "deny"
      }
    },
    {
      "id": "people-claim",
      "description": "Only a signed-in person claims. An agent never claims its own sandbox.",
      "actions": [
        "claim"
      ],
      "when": {
        "not": {
          "subject": "actor",
          "path": "kind",
          "op": "eq",
          "value": "person"
        }
      },
      "effect": {
        "effect": "deny"
      }
    },
    {
      "id": "dna-admin-reads-registrations",
      "description": "The DNA admin role, granted by the platform's operator, reads registrations across organizations.",
      "actions": [
        "read-registrations"
      ],
      "when": {
        "allOf": [
          {
            "subject": "actor",
            "path": "role",
            "op": "eq",
            "value": "dna-admin"
          },
          {
            "subject": "actor",
            "path": "organization",
            "op": "eq",
            "value": "dna-codes"
          }
        ]
      },
      "effect": {
        "effect": "allow"
      }
    },
    {
      "id": "dna-admin-suspends",
      "description": "Only the DNA admin suspends, reinstates or retires an organization.",
      "actions": [
        "suspend",
        "reinstate",
        "retire"
      ],
      "when": {
        "allOf": [
          {
            "subject": "actor",
            "path": "role",
            "op": "eq",
            "value": "dna-admin"
          },
          {
            "subject": "actor",
            "path": "organization",
            "op": "eq",
            "value": "dna-codes"
          }
        ]
      },
      "effect": {
        "effect": "allow"
      }
    },
    {
      "id": "people-set-egress",
      "description": "Only a signed-in person of the organization sets its egress allowlist. An agent never widens it.",
      "actions": [
        "set-egress-allowlist"
      ],
      "when": {
        "not": {
          "subject": "actor",
          "path": "kind",
          "op": "eq",
          "value": "person"
        }
      },
      "effect": {
        "effect": "deny"
      }
    }
  ]
}
