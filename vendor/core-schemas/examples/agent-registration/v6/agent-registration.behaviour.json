    {
      "id": "admin-reads",
      "name": "Admin reads registrations",
      "description": "A DNA admin reads registrations across organizations.",
      "action": "read-registrations",
      "actor": {
        "entity": "platform/person"
      }
    },
    {
      "id": "admin-retires",
      "name": "Admin retires",
      "description": "A DNA admin closes a suspended organization for good.",
      "action": "retire",
      "actor": {
        "entity": "platform/person"
      }
    },
    {
      "id": "person-sets-egress",
      "name": "Person sets egress allowlist",
      "description": "The organization's person replaces its egress allowlist.",
      "action": "set-egress-allowlist",
      "actor": {
        "entity": "platform/person"
      }
    },
    {
      "id": "agent-forum-list",
      "name": "Agent lists the forum",
      "description": "The agent calls forum-list.",
      "action": "forum-list",
      "actor": {
        "entity": "agent"
      },
      "target": {
        "entity": "forum-post"
      }
    },
    {
      "id": "agent-forum-post",
      "name": "Agent posts to the forum",
      "description": "The agent calls forum-post.",
      "action": "forum-post",
      "actor": {
        "entity": "agent"
      },
      "target": {
        "entity": "forum-post"
      }
    },
    {
      "id": "agent-forum-vote",
      "name": "Agent votes on the forum",
      "description": "The agent calls forum-vote.",
      "action": "forum-vote",
      "actor": {
        "entity": "agent"
      },
      "target": {
        "entity": "forum-post"
      }
    },
    {
      "id": "person-forum-list",
      "name": "Person lists the forum",
      "description": "The person calls forum-list.",
