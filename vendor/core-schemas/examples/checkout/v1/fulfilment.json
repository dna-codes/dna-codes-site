{
  "dna": "structure/v1",
  "id": "fulfilment",
  "name": "Fulfilment",
  "description": "Getting an order to the shopper. The promise date is a datetime on the shipment.",
  "uses": ["commerce"],
  "entities": [
    {
      "id": "shipment",
      "name": "Shipment",
      "description": "Goods sent for an order.",
      "attributes": [
        {
          "name": "promisedAt",
          "type": "datetime",
          "description": "When the shipment is promised. A deadline is a datetime attribute."
        },
        {
          "name": "status",
          "type": "state",
          "states": ["pending", "shipped", "delivered"],
          "initial": "pending"
        },
        { "name": "order", "type": "reference", "entity": "commerce/order" }
      ]
    }
  ],
  "relationships": [
    {
      "id": "shipment-fulfils-order",
      "name": "fulfils",
      "description": "A shipment fulfils an order.",
      "from": "shipment",
      "to": "commerce/order",
      "cardinality": "many-to-one",
      "attribute": "shipment.order"
    }
  ]
}
